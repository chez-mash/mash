# winget installer manifest for the Mash desktop app, filled by packaging/render.py.
# The installers are the NSIS installers Tauri builds: they install for the
# current user without elevation, /S installs silently and /P shows only the
# progress bar. ProductCode and AppsAndFeaturesEntries are what the installer
# writes under the user's Uninstall registry key; release-check.yml's winget
# job compares them with an installed copy.
# yaml-language-server: $schema=https://aka.ms/winget-manifest.installer.1.10.0.schema.json
PackageIdentifier: MashHQ.Mash
PackageVersion: @VERSION@
InstallerType: nullsoft
Scope: user
InstallModes:
  - interactive
  - silent
  - silentWithProgress
InstallerSwitches:
  Silent: /S
  SilentWithProgress: /P
UpgradeBehavior: install
Protocols:
  - mash
ProductCode: Mash
AppsAndFeaturesEntries:
  - DisplayName: Mash
    Publisher: getmash
    ProductCode: Mash
# The app and the engine it carries are built against the Visual C++ runtime
# for their architecture.
Installers:
  - Architecture: x64
    InstallerUrl: https://github.com/mashhq/mash/releases/download/v@VERSION@/mash-desktop-windows-x64-setup.exe
    InstallerSha256: @SHA256_UPPER:mash-desktop-windows-x64-setup.exe@
    Dependencies:
      PackageDependencies:
        - PackageIdentifier: Microsoft.VCRedist.2015+.x64
  - Architecture: arm64
    InstallerUrl: https://github.com/mashhq/mash/releases/download/v@VERSION@/mash-desktop-windows-arm64-setup.exe
    InstallerSha256: @SHA256_UPPER:mash-desktop-windows-arm64-setup.exe@
    Dependencies:
      PackageDependencies:
        - PackageIdentifier: Microsoft.VCRedist.2015+.arm64
ManifestType: installer
ManifestVersion: 1.10.0
