{
    "version": "@VERSION@",
    "description": "Search past coding-agent chats from your browser, terminal, or agents",
    "homepage": "https://github.com/chez-mash/mash",
    "license": "MIT OR Apache-2.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/chez-mash/mash/releases/download/v@VERSION@/mash-x86_64-pc-windows-msvc.zip",
            "hash": "@SHA256:mash-x86_64-pc-windows-msvc.zip@"
        },
        "arm64": {
            "url": "https://github.com/chez-mash/mash/releases/download/v@VERSION@/mash-aarch64-pc-windows-msvc.zip",
            "hash": "@SHA256:mash-aarch64-pc-windows-msvc.zip@"
        }
    },
    "bin": ["mash.exe", "mash-server.exe"],
    "notes": "Run mash qdrant install, then mash init to choose which histories to read. Run mash dash and open the address it prints to search in your browser. For setup details, visit https://getmash.io/installation/.",
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/chez-mash/mash/releases/download/v$version/mash-x86_64-pc-windows-msvc.zip"
            },
            "arm64": {
                "url": "https://github.com/chez-mash/mash/releases/download/v$version/mash-aarch64-pc-windows-msvc.zip"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS"
        }
    }
}
