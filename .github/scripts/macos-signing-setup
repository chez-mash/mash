#!/usr/bin/env bash
# Prepares this macOS runner to sign and notarize, when the repository has the
# Apple secrets: imports the Developer ID certificate into a temporary keychain
# and writes the App Store Connect API key to a file. Without the secrets it
# says so and does nothing, so forks and unsigned builds keep working.
#
# Reads APPLE_CERTIFICATE (base64 .p12), APPLE_CERTIFICATE_PASSWORD,
# APPLE_API_KEY_P8 (the .p8 text), APPLE_API_KEY_ID and APPLE_API_ISSUER.
# Writes MASH_SIGN=1, APPLE_SIGNING_IDENTITY and APPLE_API_KEY_PATH to
# $GITHUB_ENV for later steps.
set -euo pipefail

if [ -z "${APPLE_CERTIFICATE:-}" ] || [ -z "${APPLE_API_KEY_P8:-}" ]; then
  echo "Apple signing secrets are not set; building unsigned."
  exit 0
fi

keychain="$RUNNER_TEMP/mash-signing.keychain-db"
keychain_password=$(openssl rand -hex 24)
certificate="$RUNNER_TEMP/mash-signing.p12"
printf '%s' "$APPLE_CERTIFICATE" | base64 --decode > "$certificate"
security create-keychain -p "$keychain_password" "$keychain"
security set-keychain-settings -lut 21600 "$keychain"
security unlock-keychain -p "$keychain_password" "$keychain"
security import "$certificate" -P "$APPLE_CERTIFICATE_PASSWORD" -A -t cert -f pkcs12 -k "$keychain"
security set-key-partition-list -S apple-tool:,apple: -k "$keychain_password" "$keychain" >/dev/null
security list-keychains -d user -s "$keychain" $(security list-keychains -d user | tr -d '"')
rm -f "$certificate"

identity=$(security find-identity -v -p codesigning "$keychain" | sed -n 's/.*"\(Developer ID Application: .*\)"/\1/p' | head -1)
if [ -z "$identity" ]; then
  echo "::error::The certificate in APPLE_CERTIFICATE is not a Developer ID Application certificate."
  exit 1
fi

key="$RUNNER_TEMP/mash-notary.p8"
printf '%s\n' "$APPLE_API_KEY_P8" > "$key"
{
  echo "MASH_SIGN=1"
  echo "APPLE_SIGNING_IDENTITY=$identity"
  echo "APPLE_API_KEY_PATH=$key"
  # Tauri reads the key's id from APPLE_API_KEY.
  echo "APPLE_API_KEY=$APPLE_API_KEY_ID"
} >> "$GITHUB_ENV"
echo "Signing as: $identity"
