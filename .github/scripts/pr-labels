#!/usr/bin/env bash
# Apply the pull request labels that follow from facts alone: changed paths
# and the template's Intent and AI assistance sections. CONTRIBUTING.md
# describes the labels; .github/labels.tsv defines them.
#
# Usage: .github/scripts/pr-labels NUMBER   (needs GH_TOKEN and GH_REPO)
#
# With PR_LABELS_FILES and PR_LABELS_BODY set it reads those instead of the
# API and only prints what it would do, for tools/test-pr-labels.sh.
#
# area: and touches: labels and the category: label are only added, never
# removed, and the category is set only when the pull request has none, so a
# maintainer's label wins. needs:intent and needs:ai-disclosure track the
# description and are added or removed on every run.
set -euo pipefail

number=${1:?usage: pr-labels NUMBER}
dry=false
if [[ -n ${PR_LABELS_FILES+x} ]]; then
	dry=true
	files=$PR_LABELS_FILES
	body=${PR_LABELS_BODY-}
	labels=${PR_LABELS_EXISTING-}
else
	repo=${GH_REPO:?GH_REPO must name owner/repo}
	pr=$(gh api "repos/$repo/pulls/$number")
	body=$(jq -r '.body // ""' <<<"$pr" | tr -d '\r')
	labels=$(jq -r '.labels[].name' <<<"$pr")
	files=$(gh api --paginate "repos/$repo/pulls/$number/files" -q '.[].filename')
fi

has_label() { grep -qxF "$1" <<<"$labels"; }
has_prefix() { grep -q "^$1" <<<"$labels"; }

add=()
remove=()

docs_only=true
tooling_or_docs=true
while IFS= read -r file; do
	[[ -n $file ]] || continue
	case $file in
	crates/mash-dash/* | dashboard/*) add+=(area:dashboard) ;;
	crates/mash-search/* | crates/mash-query/*) add+=(area:search) ;;
	crates/mash-silver/*) add+=(area:history) ;;
	crates/mash-storage/* | crates/mash-sync/*) add+=(area:storage) ;;
	crates/mash-server/* | crates/mash-fleet/* | deployment/*) add+=(area:server) ;;
	crates/mash-mcp/* | plugins/*) add+=(area:agents) ;;
	install.sh | install.ps1 | packaging/* | bucket/* | .github/workflows/release*) add+=(area:install) ;;
	cli/* | app/*) add+=(area:cli) ;;
	esac
	case $file in
	crates/mash-storage/src/storage/silver.sql | crates/mash-storage/src/storage/records.sql) add+=(touches:schema) ;;
	dashboard/openapi.json | docs/internal/shared-server-openapi.json | \
		plugins/mash/skills/mash-history/contract.json | deployment/*/openapi.json)
		add+=(touches:contract)
		;;
	protocol/*) add+=(touches:protocol) ;;
	esac
	case $file in
	docs/* | site/* | assets/* | .agents/* | *.md | LICENSE-*) ;;
	.github/* | tools/* | packaging/* | bucket/* | .greptile/* | .claude/* | .codex/* | .cargo/* | \
		Makefile | Cargo.lock | deny.toml | rust-toolchain.toml | .gitignore | .gitattributes | \
		.mcp.json | sqlc.yaml)
		docs_only=false
		;;
	*)
		docs_only=false
		tooling_or_docs=false
		;;
	esac
done <<<"$files"

# section TITLE prints a template section's text without HTML comments.
section() {
	awk -v title="## $1" '
		$0 == title { inside = 1; next }
		/^## / { inside = 0 }
		inside { print }
	' <<<"$body" | perl -0pe 's/<!--.*?-->//gs'
}

# Intent: the boxes the author ticked, mapped to category labels.
intent=$(section Intent | grep -iE '^\s*[-*] \[x\]' || true)
declare -A intents=(
	[fix]=category:fix
	[feature]=category:feature
	[performance]=category:performance
	[refactor]=category:refactor
	[documentation]=category:docs
	[tooling]=category:tooling
)
declared=()
for key in "${!intents[@]}"; do
	if grep -qiE "^\s*[-*] \[x\] \*\*$key\*\*" <<<"$intent"; then
		declared+=("${intents[$key]}")
	fi
done

if ((${#declared[@]} == 0)); then
	add+=(needs:intent)
else
	remove+=(needs:intent)
fi

if ! has_prefix category:; then
	if ((${#declared[@]} == 1)); then
		add+=("${declared[0]}")
	elif ((${#declared[@]} == 0)) && [[ -n $files ]]; then
		if $docs_only; then
			add+=(category:docs)
		elif $tooling_or_docs; then
			add+=(category:tooling)
		fi
	fi
fi

# AI assistance: any text left once comments are stripped counts, including
# "None"; an untouched template does not.
if [[ -n $(section 'AI assistance' | tr -d '[:space:]') ]]; then
	remove+=(needs:ai-disclosure)
else
	add+=(needs:ai-disclosure)
fi

for label in $(printf '%s\n' "${add[@]}" | sort -u); do
	if ! has_label "$label" && ! $dry; then
		gh pr edit "$number" --repo "$repo" --add-label "$label" >/dev/null
	fi
	echo "label: $label"
done
for label in "${remove[@]}"; do
	if has_label "$label"; then
		$dry || gh pr edit "$number" --repo "$repo" --remove-label "$label" >/dev/null
		echo "unlabel: $label"
	fi
done
