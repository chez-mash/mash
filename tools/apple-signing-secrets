#!/usr/bin/env bash
# Uploads Mash's Apple signing secrets to GitHub, from your Mac, in one go.
# Nothing is printed or written to disk: each value goes straight from this
# script into `gh secret set`.
#
# Before running it:
#   1. Xcode → Settings → Accounts → Manage Certificates → + → Developer ID
#      Application. Then in Keychain Access, right-click "Developer ID
#      Application: …" → Export… → save a .p12 with a password.
#   2. App Store Connect → Users and Access → Integrations → App Store Connect
#      API → Team Keys → + (access: Developer). Download the .p8, and note the
#      Key ID and the Issuer ID shown on that page.
#
# Usage: tools/apple-signing-secrets path/to/cert.p12 path/to/AuthKey_XXXX.p8 [owner/repo]
set -euo pipefail

p12=${1:?give the path to the exported .p12}
p8=${2:?give the path to the downloaded .p8}
repo=${3:-grep-stack/mash}
command -v gh >/dev/null || { echo "Install the GitHub CLI (brew install gh) and run gh auth login first." >&2; exit 1; }
gh auth status >/dev/null 2>&1 || { echo "Run gh auth login first." >&2; exit 1; }
[ -f "$p12" ] && [ -f "$p8" ] || { echo "One of the files was not found." >&2; exit 1; }

read -r -s -p "Password you set when exporting the .p12: " p12_password; echo
# Check the password and the certificate type before uploading anything.
subject=$(openssl pkcs12 -in "$p12" -passin "pass:$p12_password" -nokeys -legacy 2>/dev/null \
  || openssl pkcs12 -in "$p12" -passin "pass:$p12_password" -nokeys 2>/dev/null) \
  || { echo "That password does not open the .p12." >&2; exit 1; }
case "$subject" in
  *"Developer ID Application"*) ;;
  *) echo "The .p12 is not a Developer ID Application certificate." >&2; exit 1 ;;
esac

default_key_id=$(basename "$p8" | sed -n 's/^AuthKey_\(.*\)\.p8$/\1/p')
read -r -p "Key ID${default_key_id:+ [$default_key_id]}: " key_id
key_id=${key_id:-$default_key_id}
read -r -p "Issuer ID: " issuer
[ -n "$key_id" ] && [ -n "$issuer" ] || { echo "Both IDs are needed." >&2; exit 1; }

base64 -i "$p12" | tr -d '\n' | gh secret set APPLE_CERTIFICATE --repo "$repo"
printf '%s' "$p12_password" | gh secret set APPLE_CERTIFICATE_PASSWORD --repo "$repo"
gh secret set APPLE_API_KEY_P8 --repo "$repo" < "$p8"
printf '%s' "$key_id" | gh secret set APPLE_API_KEY_ID --repo "$repo"
printf '%s' "$issuer" | gh secret set APPLE_API_ISSUER --repo "$repo"
echo "Done: five Apple secrets set on $repo. You can delete the .p12 and .p8 now (keep a backup of the .p8 somewhere safe; Apple won't let you download it again)."
