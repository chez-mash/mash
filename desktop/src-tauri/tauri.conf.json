{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mash",
  "identifier": "io.getmash.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "app",
      "dmg",
      "nsis"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Search the history of your coding agents",
    "longDescription": "Mash finds past chats, decisions and records across your coding agents and machines. The app runs the Mash dashboard in its own window.",
    "copyright": "MIT OR Apache-2.0",
    "externalBin": [
      "binaries/mash"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "files": {
        "Resources/Assets.car": "icons/Assets.car"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEzMTQ4RjZCNjc3NDI1MjQKUldRa0pYUm5hNDhVRXlUczJQYjFkeTdtMUxadWEzaXdwSW01a0NmVWFRRVQ4cUtoZ1lzYjNrY0IK",
      "requireSignedVersion": true
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "mash"
        ]
      }
    }
  }
}
