{
  "name": "mash-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode demo",
    "build": "vite build",
    "build:demo": "vite build --mode demo",
    "contract": "openapi-typescript openapi.json -o src/lib/contract.ts",
    "preview": "vite preview",
    "check": "svelte-check --tsgo --fail-on-warnings",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:changed": "vitest run --changed origin/main",
    "test:browser": "playwright test",
    "e2e:affected": "python3 ../tools/affected_tests.py --run",
    "knip": "knip"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@internationalized/date": "^3.12.4",
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "bits-ui": "^2.22.0",
    "clsx": "^2.1.1",
    "knip": "6.48.0",
    "openapi-typescript": "^7.13.0",
    "phosphor-svelte": "3.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.4",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fontsource/geist": "5.3.0",
    "@fontsource/geist-mono": "5.3.0",
    "@tanstack/svelte-query": "^6.3.10",
    "dompurify": "^3.4.17",
    "marked": "^18.1.3",
    "shiki": "4.6.0"
  }
}
