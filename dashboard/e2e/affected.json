{
  "about": "Which browser specs a change to the dashboard can affect; read by tools/affected_tests.py and explained in docs/internal/verification.md (Fast loops). Keep it true by hand: a spec lists every route it reaches, by address or by clicking.",
  "everything": [
    "package.json",
    "pnpm-lock.yaml",
    "playwright.config.ts",
    "vite.config.ts",
    "svelte.config.js",
    "tsconfig.json",
    "index.html",
    "public/*",
    "e2e/affected.json",
    "e2e/*.ts",
    "src/main.ts",
    "src/App.svelte",
    "src/*.css",
    "src/theme/*",
    "src/demo/*",
    "src/lib/components/*",
    "src/lib/api.ts",
    "src/lib/route*",
    "src/components/Rail.svelte",
    "src/components/TopBar.svelte",
    "src/components/ContextMenu.svelte",
    "src/components/TopSearch.svelte",
    "src/components/Mashy.svelte",
    "src/components/MashyButton.svelte",
    "src/lib/mashy.svelte.ts",
    "src/lib/assistant.ts",
    "src/lib/tuck.ts",
    "src/lib/reading.svelte.ts"
  ],
  "ignored": [
    "README.md",
    "biome.json",
    "components.json",
    "src/*.test.ts",
    "e2e/*.live.ts",
    "visual/*",
    "playwright.visual.config.ts"
  ],
  "router": "src/App.svelte",
  "shell": [
    "src/main.ts",
    "src/App.svelte",
    "src/components/TopBar.svelte",
    "src/components/Rail.svelte",
    "src/components/UpdateBanner.svelte",
    "src/lib/components/Icon.svelte"
  ],
  "routes": {
    "overview": ["src/components/Overview.svelte"],
    "search": ["src/components/Search.svelte"],
    "history": ["src/components/History.svelte"],
    "export": ["src/components/Transfer.svelte"],
    "projects": ["src/components/Projects.svelte"],
    "project": ["src/components/BrowseDetail.svelte"],
    "agents": ["src/components/BrowseTiles.svelte"],
    "agent": ["src/components/BrowseDetail.svelte", "src/components/AgentMark.svelte"],
    "machines": ["src/components/BrowseTiles.svelte", "src/components/SharedServer.svelte"],
    "machine": [
      "src/components/BrowseDetail.svelte",
      "src/components/MachineExtras.svelte",
      "src/components/MachineIcon.svelte"
    ],
    "services": ["src/components/ServicesView.svelte"],
    "fleet": ["src/components/Fleet.svelte"],
    "console": ["src/components/Console.svelte"],
    "settings": ["src/components/Settings.svelte"],
    "setup": ["src/components/Setup.svelte"],
    "quick": ["src/components/QuickSearch.svelte"],
    "records": ["src/components/RecordsView.svelte"],
    "record": ["src/components/RecordView.svelte"],
    "chat": ["src/components/TranscriptView.svelte"],
    "missing": ["src/components/Missing.svelte"],
    "assistant": ["src/components/Mashy.svelte"],
    "sign-in": ["src/components/SignIn.svelte"]
  },
  "specs": {
    "attachments.spec.ts": ["chat"],
    "consistency.spec.ts": [
      "overview",
      "search",
      "history",
      "export",
      "projects",
      "project",
      "console",
      "records",
      "record"
    ],
    "console.spec.ts": ["console"],
    "dashboard.spec.ts": ["overview", "search", "chat"],
    "design.spec.ts": [
      "overview",
      "search",
      "history",
      "agent",
      "machines",
      "machine",
      "records",
      "chat"
    ],
    "federated.spec.ts": ["overview", "search", "quick"],
    "fleet.spec.ts": ["fleet"],
    "floating.spec.ts": ["chat", "assistant"],
    "frame.spec.ts": ["overview", "chat"],
    "highlight.spec.ts": ["chat"],
    "live.spec.ts": ["chat"],
    "mashy.spec.ts": ["overview", "chat", "assistant"],
    "navigation.spec.ts": [
      "overview",
      "search",
      "history",
      "projects",
      "agents",
      "machines",
      "services",
      "fleet",
      "console",
      "settings",
      "records",
      "missing"
    ],
    "open-in.spec.ts": ["chat"],
    "pagination.spec.ts": ["overview", "search", "chat"],
    "plugin-repair.spec.ts": ["services"],
    "project-choices.spec.ts": ["search", "projects"],
    "quick.spec.ts": ["overview", "settings", "quick", "chat"],
    "reading.spec.ts": ["chat"],
    "records.spec.ts": ["overview", "records", "record", "chat"],
    "recovery.spec.ts": ["overview", "services"],
    "services-map.spec.ts": ["services"],
    "services.spec.ts": ["services"],
    "settings.spec.ts": ["settings"],
    "setup.spec.ts": ["overview", "setup"],
    "shared-server.spec.ts": ["machines"],
    "sharing.spec.ts": ["machines", "setup"],
    "shell-keyboard.spec.ts": ["overview", "search", "projects", "agents", "settings"],
    "shell-layout.spec.ts": [
      "overview",
      "search",
      "agents",
      "services",
      "settings",
      "records",
      "chat",
      "assistant"
    ],
    "subagents.spec.ts": ["search", "chat"],
    "theme.spec.ts": ["overview", "settings"],
    "transfer.spec.ts": ["overview", "export"],
    "update-banner.spec.ts": ["overview", "settings"],
    "viewing.spec.ts": ["overview", "search", "records"]
  }
}
