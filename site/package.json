{
  "name": "mash-docs",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "prepare-content": "node scripts/content.ts",
    "translate-docs": "node scripts/translate-docs.ts",
    "dev": "pnpm prepare-content && astro dev",
    "dev:review": "pnpm prepare-content && astro dev stop && agentation-review",
    "build": "pnpm prepare-content && astro build --force && node scripts/stylesheets.ts",
    "add-demo": "node scripts/demo.ts",
    "screenshots": "node scripts/screenshots.ts",
    "check": "pnpm prepare-content && astro sync && tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run scripts",
    "test:browser": "playwright test",
    "test:review": "playwright test --config playwright.review.config.ts",
    "knip": "pnpm prepare-content && knip"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.9",
    "@fontsource/geist": "5.3.0",
    "@fontsource/geist-mono": "5.3.0",
    "astro": "7.4.7",
    "gsap": "^3.15.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@phosphor-icons/core": "2.1.1",
    "@playwright/test": "^1.64.1",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.0.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "agentation-mcp": "1.2.0",
    "agentation-review": "github:kojah/agentation-review#83c898448be197e8d9eb8539504ee9c522236a40",
    "github-slugger": "2.0.0",
    "knip": "6.48.0",
    "mdast-util-to-string": "4.0.0",
    "vitest": "^5.1.0"
  }
}
