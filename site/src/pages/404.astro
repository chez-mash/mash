---
// The page for a missing address. Starlight's own 404 is a splash page whose
// hero would be the landing page's (Hero.astro draws the handoff, the stamp
// and the downloads for every hero), so astro.config.mjs turns that route off
// and this page says plainly what happened and where to go next. Its three
// ways out use the landing page's buttons: Home in peach, the others in paper.
//
// GitHub Pages serves this one English page for every missing address, so a
// script puts it in the language of the address asked for: /ja/… reads in
// Japanese and leads to the Japanese home and guides.
import { LinkButton } from "@astrojs/starlight/components";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { docsLocales } from "../../scripts/locales.ts";

const files = import.meta.glob<Record<string, string>>("../content/i18n/*.json", {
  eager: true,
  import: "default",
});
const english = files["../content/i18n/en.json"] ?? {};
const keys = [
  "mash.missing.title",
  "mash.missing.lead",
  "mash.missing.home",
  "mash.nav.docs",
  "mash.guides.tipSearch",
];
const languages: Readonly<Record<string, { label: string; lang?: string }>> = docsLocales;
/** Each translated locale's lang and words, keyed by its path segment. */
const words = Object.fromEntries(
  Object.entries(languages)
    .filter(([locale]) => locale !== "root")
    .map(([locale, { lang = locale }]) => {
      const strings = { ...english, ...files[`../content/i18n/${lang}.json`] };
      return [
        locale,
        { lang, strings: Object.fromEntries(keys.map((key) => [key, strings[key]])) },
      ];
    }),
);
const t = (key: string) => english[key] ?? "";
---

<StarlightPage
  frontmatter={{ title: t("mash.missing.title"), template: "splash", pagefind: false, editUrl: false }}
>
  <div class="mash-missing">
    <p class="lead" data-word="mash.missing.lead">{t("mash.missing.lead")}</p>
    <div class="actions">
      <LinkButton href="/" icon="right-arrow" data-path="">
        <span data-word="mash.missing.home">{t("mash.missing.home")}</span>
      </LinkButton>
      <LinkButton
        href="/guides/"
        variant="secondary"
        icon="open-book"
        iconPlacement="start"
        data-path="guides/"
      >
        <span data-word="mash.nav.docs">{t("mash.nav.docs")}</span>
      </LinkButton>
      <button type="button" class="find" data-mash-search>
        <span data-word="mash.guides.tipSearch">{t("mash.guides.tipSearch")}</span><kbd>Ctrl K</kbd>
      </button>
    </div>
  </div>
</StarlightPage>

<script is:inline define:vars={{ words }}>
  // Runs as the page is read, before it is drawn, so English never flashes.
  const locale = location.pathname.split("/")[1];
  const entry = Object.hasOwn(words, locale) ? words[locale] : undefined;
  if (entry) {
    const say = (key) => entry.strings[key];
    document.documentElement.lang = entry.lang;
    const title = document.getElementById("_top");
    if (title) title.textContent = say("mash.missing.title");
    document.title = document.title.replace(/^[^|]+/, `${say("mash.missing.title")} `);
    for (const element of document.querySelectorAll("[data-word]")) {
      element.textContent = say(element.dataset.word);
    }
    for (const link of document.querySelectorAll(".mash-missing [data-path]")) {
      link.href = `/${locale}/${link.dataset.path}`;
    }
    // The header's link to the guides, a word after its icon.
    for (const link of document.querySelectorAll('header a.mash-nav[href="/guides/"]')) {
      link.href = `/${locale}/guides/`;
      const word = [...link.childNodes].findLast((node) => node.nodeType === Node.TEXT_NODE);
      if (word) word.textContent = say("mash.nav.docs");
    }
  }
</script>

<style>
  .mash-missing {
    display: grid;
    justify-items: start;
    gap: 1.5rem;
    max-width: 36rem;
    padding-block: 1rem 3rem;
  }
  .mash-missing .lead {
    margin: 0;
    font-size: 1.1875rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
  }
  .actions :global(.sl-link-button),
  .find {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4375rem;
    height: 2.875rem;
    margin: 0;
    padding: 0 1.25rem;
    border: var(--border-outline);
    border-radius: var(--radius-large);
    background: var(--surface-paper);
    color: var(--text-ink);
    font: inherit;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    cursor: pointer;
  }
  .actions :global(.sl-link-button.primary) {
    border-color: var(--line-ink);
    background: var(--fill-peach);
    color: var(--text-on-fill);
  }
  .actions :global(.sl-link-button:hover),
  .find:hover {
    background: var(--surface-cream);
  }
  .actions :global(.sl-link-button.primary:hover) {
    background: var(--action-hover-bg);
  }
  .find:focus-visible {
    outline: var(--stroke-outline) solid var(--line-ink);
    outline-offset: 2px;
  }
  .find kbd {
    margin-inline-start: 0.25rem;
    padding: 0.1875rem 0.3125rem;
    border: var(--border-fill);
    border-radius: var(--radius-key);
    background: var(--fill-sticker-cream);
    color: var(--text-on-fill);
    font-family: var(--type-mono);
    font-size: 0.6875rem;
    font-weight: 500;
  }
  @media (hover: none), (pointer: coarse) {
    .find kbd {
      display: none;
    }
  }
  @media (width < 40rem) {
    .actions {
      flex-direction: column;
      align-self: stretch;
      width: 100%;
    }
    .actions :global(.sl-link-button),
    .find {
      width: 100%;
    }
  }
</style>
