---
// The page for a missing address. Starlight's own 404 is a splash page whose
// hero would be the landing page's, so astro.config.mjs turns that route off
// and this page says plainly what happened and where to go next: Mashy tipped
// over, the title, a field that opens search, Home in ink and the docs
// beside it, and three places to start.
//
// GitHub Pages serves this one English page for every missing address, so a
// script puts it in the language of the address asked for: /ja/… reads in
// Japanese and leads to the Japanese home and guides.
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { docsLocales } from "../../scripts/locales.ts";
import tipped from "../art/mashy-tipped.svg?raw";
import LineIcon from "../components/LineIcon.astro";

const files = import.meta.glob<Record<string, string>>("../content/i18n/*.json", {
  eager: true,
  import: "default",
});
const english = files["../content/i18n/en.json"] ?? {};
const keys = [
  "mash.missing.title",
  "mash.missing.lead",
  "mash.missing.home",
  "mash.missing.startWith",
  "mash.missing.quickStart",
  "mash.missing.downloads",
  "mash.missing.agents",
  "mash.nav.docs",
  "mash.guides.tipSearch",
];
const languages: Readonly<Record<string, { label: string; lang?: string }>> = docsLocales;
/** Each translated locale's lang and words, keyed by its path segment. */
const words = Object.fromEntries(
  Object.entries(languages)
    .filter(([locale]) => locale !== "root")
    .map(([locale, { lang = locale }]) => {
      const strings = { ...english, ...files[`../content/i18n/${lang}.json`] };
      return [
        locale,
        { lang, strings: Object.fromEntries(keys.map((key) => [key, strings[key]])) },
      ];
    }),
);
const t = (key: string) => english[key] ?? "";
const art = tipped.replace("<svg", '<svg class="art" role="img" aria-label="Mashy, tipped over"');
const starts = [
  ["mash.missing.quickStart", "quick-start/"],
  ["mash.missing.downloads", "downloads/"],
  ["mash.missing.agents", "supported-agents/"],
] as const;
---

<StarlightPage
  frontmatter={{ title: t("mash.missing.title"), template: "splash", pagefind: false, editUrl: false }}
>
  <div class="mash-missing not-content">
    <Fragment set:html={art} />
    <p class="code">404</p>
    <h1 id="_top" data-word="mash.missing.title">{t("mash.missing.title")}</h1>
    <p class="lead" data-word="mash.missing.lead">{t("mash.missing.lead")}</p>
    {/* Looks like a search field and opens the site's search. */}
    <button type="button" class="find" data-mash-search>
      <LineIcon name="search" size="1.0625rem" />
      <span data-word="mash.guides.tipSearch">{t("mash.guides.tipSearch")}</span><kbd>Ctrl K</kbd>
    </button>
    <div class="actions">
      <a class="button primary" href="/" data-path="">
        <LineIcon name="house" size="0.9375rem" />
        <span data-word="mash.missing.home">{t("mash.missing.home")}</span>
      </a>
      <a class="button" href="/guides/" data-path="guides/">
        <LineIcon name="book-open" size="0.9375rem" />
        <span data-word="mash.nav.docs">{t("mash.nav.docs")}</span>
      </a>
    </div>
    <nav class="starts" aria-labelledby="missing-starts">
      <p id="missing-starts" data-word="mash.missing.startWith">{t("mash.missing.startWith")}</p>
      <ul>
        {starts.map(([key, path]) => (
          <li><a href={`/${path}`} data-path={path} data-word={key}>{t(key)}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</StarlightPage>

<script is:inline define:vars={{ words }}>
  // Runs as the page is read, before it is drawn, so English never flashes.
  const locale = location.pathname.split("/")[1];
  const entry = Object.hasOwn(words, locale) ? words[locale] : undefined;
  if (entry) {
    const say = (key) => entry.strings[key];
    document.documentElement.lang = entry.lang;
    document.title = document.title.replace(/^[^|]+/, `${say("mash.missing.title")} `);
    for (const element of document.querySelectorAll(".mash-missing [data-word]")) {
      element.textContent = say(element.dataset.word);
    }
    for (const link of document.querySelectorAll(".mash-missing [data-path]")) {
      link.href = `/${locale}/${link.dataset.path}`;
    }
    // The header's link to the guides.
    for (const link of document.querySelectorAll('header a[href="/guides/"]')) {
      link.href = `/${locale}/guides/`;
      link.textContent = say("mash.nav.docs");
    }
  }
</script>

<style>
  .mash-missing {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 35rem;
    margin: 0 auto;
    padding: 3.5rem 0 5rem;
    text-align: center;
  }
  .mash-missing > :global(*) {
    margin: 0;
  }
  .mash-missing :global(.art) {
    display: block;
    width: 10.5rem;
    height: 10.5rem;
  }
  .code {
    margin-top: 1.75rem;
    color: var(--text-faint);
    font: 500 0.8125rem / 1 var(--type-mono);
  }
  h1 {
    margin-top: 0.75rem;
    font-size: 2.75rem;
    font-weight: 600;
    line-height: 1.06;
    letter-spacing: -0.04em;
  }
  .lead {
    margin-top: 1rem;
    color: var(--text-muted);
    font-size: 1.125rem;
    line-height: 1.6;
  }
  .find {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    width: 100%;
    height: 3rem;
    margin-top: 2rem;
    padding: 0 0.625rem 0 1rem;
    border: 0;
    border-radius: var(--radius-6);
    background: var(--surface-raised);
    box-shadow: var(--shadow-float);
    color: var(--text-faint);
    font: 400 0.9375rem / 1 var(--type-sans);
    cursor: text;
  }
  .find span {
    flex: 1;
    text-align: start;
  }
  .find:hover {
    color: var(--text-strong);
  }
  .find kbd {
    padding: 0.1875rem 0.3125rem;
    border-radius: var(--radius-2);
    background: var(--surface-raised);
    box-shadow: var(--shadow-kbd);
    color: var(--text-secondary);
    font: 500 0.6875rem / 1 var(--type-mono);
  }
  @media (hover: none), (pointer: coarse) {
    .find kbd {
      display: none;
    }
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.625rem;
    margin-top: 1.25rem;
  }
  .button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 2.625rem;
    padding: 0 1.125rem;
    border-radius: var(--radius-5);
    box-shadow: var(--shadow-ring);
    color: var(--text-strong);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
  }
  .button:hover {
    background: var(--surface-hover);
  }
  .button.primary {
    background: var(--action-bg);
    box-shadow: var(--shadow-button);
    color: var(--action-text);
  }
  .button.primary:hover {
    background: var(--action-hover-bg);
  }
  .starts {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    margin-top: 2.5rem;
  }
  .starts p {
    margin: 0;
    color: var(--text-faint);
    font-size: 0.75rem;
    font-weight: 500;
  }
  .starts ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .starts li {
    margin: 0;
  }
  .starts a {
    display: inline-flex;
    align-items: center;
    height: 2rem;
    padding: 0 0.625rem;
    border-radius: var(--radius-4);
    color: var(--text-muted);
    font-size: 0.8125rem;
    text-decoration: none;
  }
  .starts a:hover {
    background: var(--surface-hover);
    color: var(--text-strong);
  }
  @media (width < 40rem) {
    .mash-missing {
      padding-top: 2rem;
    }
    h1 {
      font-size: 2.25rem;
    }
  }
</style>
