---
// The first band under the agents row: the plugin from the reader's side.
// Most people meet Mash through their agents rather than one of its windows,
// so this comes before the surface showcase. Four cards tell one made-up
// story in plain chat bubbles: a choice made with Codex, Mash remembering it,
// and Claude Code answering from it later. They show what the reader sees,
// never how the plugin finds it.
import AgentTile from "./AgentTile.astro";
import CardRail from "./CardRail.astro";

const steps = [
  { name: "You chat with Codex", says: "You talk a choice through, the way you always do." },
  { name: "Mash remembers", says: "What you settled is kept, with the chat it came from." },
  {
    name: "Later, you ask Claude",
    says: "A different agent, days later. You don’t explain it again.",
  },
  { name: "Claude already knows", says: "It answers from your Codex chat, and says so." },
];
---

<section class="band" id="welcome-plugin" aria-labelledby="welcome-plugin-title">
  <div class="wrapper stack plugin" data-reveal>
    <div class="head">
      <span class="kicker">Agent plugin</span>
      <h2 id="welcome-plugin-title">Start in one agent. <span class="quiet">Finish in another.</span></h2>
      <p class="blurb">
        Most days you won’t open Mash at all. With the plugin installed, your agents remember each
        other’s chats, so the next one already knows what you decided with the last.
      </p>
    </div>
    <CardRail label="Codex, then Claude Code, with Mash in between, step by step" href="/plugin/" more="How the plugin works">
      {steps.map(({ name, says }, index) => (
        <li class="flow-card" data-flow-card>
          <span class="flow-head">
            <span class="flow-n" aria-hidden="true">{index + 1}</span>
            <b>{name}</b>
          </span>
          <span class="flow-says">{says}</span>
          <span class="flow-picture" aria-hidden="true">
            {index === 0 && (
              <span class="chat">
                <span class="who" data-in><AgentTile agent="codex" /><b>Codex</b><small>Tuesday</small></span>
                <span class="said you" data-in>Postgres or SQLite for the sync server?</span>
                <span class="said agent" data-in>Postgres. Several of your machines will write to it at once.</span>
                <span class="said you" data-in>Makes sense. Let’s go with Postgres.</span>
              </span>
            )}
            {index === 1 && (
              <span class="chat">
                <span class="kept" data-in>
                  <span class="who"><img src="/mash-mark.svg" alt="" width="20" height="20" /><b>Mash remembers</b></span>
                  <span class="kept-says">The sync server uses Postgres, because several machines write at once.</span>
                  <span class="from"><AgentTile agent="codex" />From your chat with Codex · Tuesday</span>
                </span>
              </span>
            )}
            {index === 2 && (
              <span class="chat">
                <span class="who" data-in><AgentTile agent="claude-code" /><b>Claude Code</b><small>Friday</small></span>
                <span class="said you" data-in>Which database did we pick for the sync server, and why?</span>
              </span>
            )}
            {index === 3 && (
              <span class="chat">
                <span class="who" data-in><AgentTile agent="claude-code" /><b>Claude Code</b><small>Friday</small></span>
                <span class="said agent" data-in>
                  Postgres. You decided it with Codex on Tuesday, because several of your machines write
                  to it at once.
                </span>
                <span class="from cite" data-in><AgentTile agent="codex" />From your chat with Codex</span>
              </span>
            )}
          </span>
        </li>
      ))}
    </CardRail>
  </div>
</section>

<style>
  .plugin {
    gap: 2.5rem;
  }
  .flow-card {
    display: flex;
    flex: 0 0 min(21.5rem, 84%);
    flex-direction: column;
    height: 25rem;
    overflow: hidden;
    border-radius: var(--radius-8);
    background: var(--surface-raised);
    box-shadow: var(--shadow-float);
    color: var(--text-body);
    scroll-snap-align: start;
  }
  .flow-head {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 1rem 1rem 0;
    color: var(--text-strong);
  }
  .flow-n {
    display: grid;
    flex: none;
    place-items: center;
    width: 1.625rem;
    height: 1.625rem;
    border-radius: var(--radius-round);
    background: var(--butter);
    color: var(--text-on-butter);
    font: 600 0.8125rem / 1 var(--type-mono);
  }
  .flow-head b {
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }
  .flow-says {
    min-height: 2.625rem;
    padding: 0.5rem 1rem 0.875rem;
    color: var(--text-muted);
    font-size: 0.875rem;
    line-height: 1.5;
  }
  /* The picture sits on a butter wash, as the dashboard's highlighted rows do. */
  .flow-picture {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: center;
    min-height: 0;
    margin: 0 0.5rem 0.5rem;
    padding: 1rem;
    overflow: hidden;
    border-radius: var(--radius-6);
    background: color-mix(in srgb, var(--butter) 9%, var(--surface-muted));
    font-size: 0.875rem;
    line-height: 1.5;
  }

  /* Every picture is a few chat bubbles under the name of who is talking. */
  .chat {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  .who {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .who b {
    color: var(--text-strong);
    font-weight: 600;
  }
  .who small {
    margin-inline-start: auto;
    color: var(--text-faint);
    font-size: 0.75rem;
  }
  .said {
    max-width: 88%;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-6);
    box-shadow: var(--shadow-ring);
  }
  .said.you {
    align-self: flex-end;
    background: var(--surface-muted);
    color: var(--text-strong);
  }
  .said.agent {
    align-self: flex-start;
    background: var(--surface-raised);
  }

  /* What Mash keeps: the decision, and the chat it came from. */
  .kept {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1rem;
    border-radius: var(--radius-6);
    background: var(--surface-raised);
    box-shadow: var(--shadow-butter);
  }
  .kept-says {
    color: var(--text-strong);
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .from {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-muted);
    font-size: 0.75rem;
  }
  .from.cite {
    align-self: flex-start;
    padding: 0.375rem 0.625rem;
    border-radius: var(--radius-5);
    background: var(--surface-raised);
    box-shadow: var(--shadow-ring);
  }

  /* Once the rail is live, a card's picture plays in as the card comes into view.
     Served without the script, every picture is simply shown. */
  :global(.rail-live) .flow-card [data-in] {
    opacity: 0;
    translate: 0 0.5rem;
    transition:
      opacity 0.4s ease-out,
      translate 0.4s ease-out;
  }
  :global(.rail-live) .flow-card.seen [data-in] {
    opacity: 1;
    translate: 0 0;
  }
  .flow-card.seen [data-in]:nth-child(2) {
    transition-delay: 0.3s;
  }
  .flow-card.seen [data-in]:nth-child(3) {
    transition-delay: 0.6s;
  }
  .flow-card.seen [data-in]:nth-child(4) {
    transition-delay: 0.9s;
  }
</style>
