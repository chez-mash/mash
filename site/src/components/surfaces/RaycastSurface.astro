---
// The Mash extension in Raycast, as its store pictures show it: the search
// field with what is searched, chats grouped by when they were last active,
// and the bar of actions under them. A made-up history.
import type { Agent } from "../../../../dashboard/src/lib/types";
import AgentTile from "../AgentTile.astro";
import LineIcon from "../LineIcon.astro";

const groups: {
  when: string;
  rows: { agent: Agent; title: string; project: string; age: string }[];
}[] = [
  {
    when: "Today",
    rows: [
      {
        agent: "claude-code",
        title: "Checkout is timing out for some customers since this morning’s deploy.",
        project: "checkout",
        age: "3h",
      },
    ],
  },
  {
    when: "This week",
    rows: [
      {
        agent: "opencode",
        title: "Invoice exports are stuck in the queue again for larger customers.",
        project: "billing",
        age: "1d",
      },
      {
        agent: "codex",
        title: "Plan the move of the cart service from Redis to Postgres.",
        project: "checkout",
        age: "Nov 20",
      },
    ],
  },
  {
    when: "Earlier",
    rows: [
      {
        agent: "cursor",
        title: "Why do refunds for customers in Canada round the tax down?",
        project: "billing",
        age: "Nov 9",
      },
      {
        agent: "copilot",
        title: "Email customers when their card is about to expire.",
        project: "notifications",
        age: "Oct 28",
      },
    ],
  },
];
---

<div class="ray" aria-hidden="true">
  <div class="ray-q">
    <LineIcon name="arrow-left" size="1rem" />
    <b data-typed>customers</b>
    <span><LineIcon name="message-square" size="0.875rem" />Chats · All machines</span>
  </div>
  <div class="ray-list">
    {groups.map((group, index) => (
      <>
        <p class:list={{ third: index === 2 }} data-in>{group.when}</p>
        {group.rows.map((row, at) => (
          <div class:list={["ray-row", { on: index === 0 && at === 0, third: index === 2 }]} data-in>
            <AgentTile agent={row.agent} />
            <b>{row.title}</b>
            <span>{row.project}</span>
            <span class="age">{row.age}</span>
          </div>
        ))}
      </>
    ))}
  </div>
  <div class="ray-f">
    <span class="ray-name"><img src="/mash-mark.svg" alt="" width="18" height="18" />Search Mash</span>
    <span class="ray-do"><b>Open in Mash</b><kbd>↵</kbd><i></i>Actions<kbd>⌘</kbd><kbd>K</kbd></span>
  </div>
</div>

<style>
  .ray {
    display: flex;
    flex-direction: column;
    width: min(46.875rem, 100%);
    height: 26.5rem;
    overflow: hidden;
    border-radius: var(--radius-8);
    background: var(--desk-panel);
    box-shadow: var(--shadow-card);
    backdrop-filter: blur(30px);
    color: var(--text-strong);
    font-size: 0.875rem;
  }
  .ray-q {
    display: flex;
    flex: none;
    align-items: center;
    gap: 0.875rem;
    height: 3.5rem;
    padding: 0 1.125rem;
    box-shadow: var(--shadow-menubar);
    color: var(--text-muted);
  }
  .ray-q b {
    flex: 1;
    color: var(--text-strong);
    font-size: 1.0625rem;
    font-weight: 400;
  }
  .ray-q span {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    white-space: nowrap;
  }
  .ray-list {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.125rem;
    min-height: 0;
    padding: 0.25rem 0.5rem;
  }
  .ray-list p {
    padding: 0.75rem 0.625rem 0.25rem;
    color: var(--text-muted);
    font-size: 0.75rem;
    font-weight: 500;
  }
  .ray-row {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-width: 0;
    height: 2.625rem;
    padding: 0 0.625rem;
    border-radius: var(--radius-5);
  }
  .ray-row.on {
    background: var(--desk-row-on);
  }
  .ray-row b {
    overflow: hidden;
    font-weight: 500;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .ray-row span {
    color: var(--text-muted);
    white-space: nowrap;
  }
  .ray-row .age {
    margin-inline-start: auto;
    padding-inline-start: 0.5rem;
    font-size: 0.75rem;
  }
  .ray-f {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    height: 2.75rem;
    padding: 0 0.875rem;
    background: var(--surface-hover);
    box-shadow: var(--shadow-band);
    color: var(--text-muted);
    font-size: 0.8125rem;
  }
  .ray-f span {
    display: flex;
    align-items: center;
    gap: 0.4375rem;
    white-space: nowrap;
  }
  .ray-f b {
    color: var(--text-strong);
    font-weight: 500;
  }
  .ray-f i {
    width: 1px;
    height: 1rem;
    margin-inline: 0.25rem;
    background: var(--line-strong);
  }
  .ray-f kbd {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.125rem;
    height: 1.125rem;
    padding: 0 0.25rem;
    box-sizing: border-box;
    border-radius: var(--radius-2);
    background: var(--surface-raised);
    box-shadow: var(--shadow-kbd);
    color: var(--text-secondary);
    font: 500 0.6875rem / 1 var(--type-mono);
  }
  @media (width < 40rem) {
    .ray {
      height: 22rem;
    }
    .ray-q span,
    .ray-row span:not(.age),
    .ray-f .ray-name,
    .ray-list .third {
      display: none;
    }
    .ray-f {
      justify-content: flex-end;
    }
    .ray-row {
      height: 2.75rem;
    }
  }
</style>
