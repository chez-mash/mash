---
// The landing hero, as the wireframe draws it: streaks of butter light behind
// the app icon and the headline, the page's own paragraph under it, the desktop
// app for the visitor's system with the page's own actions (the demo) as
// quieter buttons beside it, where else Mash runs, and the terminal
// install for each system in tabs. Other ways to install, including asking
// an agent, are in the docs.
import { headline } from "../brand.ts";
import AppIcon from "./AppIcon.astro";
import LineIcon from "./LineIcon.astro";
import OsMark from "./OsMark.astro";

const { data } = Astro.locals.starlightRoute.entry;
const { tagline, actions = [] } = data.hero ?? {};
const t = Astro.locals.t;

/** The install command for each system, as the quick start gives them. */
const installs = [
  {
    system: "linux",
    label: "Linux",
    prompt: "$",
    command:
      "curl -fsSL https://raw.githubusercontent.com/mashhq/mash/main/install.sh | sh -s -- --dashboard",
  },
  {
    system: "macos",
    label: "macOS",
    prompt: "$",
    command:
      "curl -fsSL https://raw.githubusercontent.com/mashhq/mash/main/install.sh | sh -s -- --dashboard",
  },
  {
    system: "windows",
    label: "Windows",
    prompt: "PS>",
    command:
      "& ([scriptblock]::Create((irm https://raw.githubusercontent.com/mashhq/mash/main/install.ps1))) -Dashboard",
  },
] as const;
---

<div class="mash-hero">
  {/* The entrance belongs to the page's motion (motion.ts). This marks the
      hero as waiting for it before the copy is drawn, so the copy does not
      show and then hide; if the motion has not started in three seconds the
      mark is dropped and the copy simply shows. Without scripting nothing
      is marked. */}
  <script is:inline data-astro-rerun>
    {
      const hero = document.currentScript?.parentElement ?? document.querySelector(".mash-hero");
      if (hero) {
        hero.dataset.motion = "pending";
        setTimeout(() => {
          if (hero.dataset.motion === "pending") delete hero.dataset.motion;
        }, 3000);
      }
    }
  </script>
  <div class="light" aria-hidden="true">
    <i class="streak s1"></i><i class="streak s2"></i><i class="streak s3"></i><i class="streak s4"></i>
    <i class="veil"></i>
  </div>
  <div class="hero">
    <div class="copy">
      <AppIcon id="hero-icon" class="hero-icon" />
      <h1 id="_top" data-page-title>
        {/* The last line is the claim, so a stroke of butter is drawn under
            it once it has risen (motion/hero.ts). The stroke is a tapered
            shape; what draws it is the mask's line, uncovered from the left.
            As served the line is whole, so without scripting it just shows. */}
        {headline.map((line, index) =>
          index < headline.length - 1 ? (
            <span>{line}</span>
          ) : (
            <span>
              {" "}
              <span class="accent">
                {line}
                <svg class="rule" viewBox="0 0 300 14" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                  <mask id="headline-rule" maskUnits="userSpaceOnUse" x="-10" y="-10" width="320" height="34">
                    <path class="draw" d="M0 10.6 C 45 7.6, 150 5.2, 300 4.2" fill="none" stroke="#fff" stroke-width="16" />
                  </mask>
                  <path mask="url(#headline-rule)" d="M1 9.5 C 40 5.5, 150 2.2, 299.5 4.2 C 200 6.8, 90 9.8, 10 12.2 C 5 12.6, 0 11.5, 1 9.5 Z" />
                </svg>
              </span>
            </span>
          )
        )}
      </h1>
      {
        tagline && (
          <p class="tagline">
            <Fragment set:html={tagline} />{" "}
            <a class="docs" href="/guides/">Read the docs<span aria-hidden="true"> →</span></a>
          </p>
        )
      }
      <div class="actions">
        {/* The desktop app for the visitor's system, chosen by the script
            below; without it, or on a phone, the link opens the downloads. */}
        <a class="download" href="/downloads/#desktop-app" data-download data-system="macos"><OsMark system="macos" /><OsMark system="windows" /><OsMark system="linux" /><span data-download-label>{t("mash.download.mac")}</span></a>
        {actions.map(({ attrs: { class: _className, ...attrs } = {}, link, text }) => (
          <a class="try" href={link} {...attrs}><LineIcon name="play" size="1rem" />{text}</a>
        ))}
      </div>
      <div class="download-note">
        <p>
          Free and open source · also on{" "}
          <a href="/downloads/#desktop-app" data-also><span data-also-system="windows"><OsMark system="windows" />Windows</span><span data-also-and> and </span><span data-also-system="linux"><OsMark system="linux" />Linux</span><span data-also-system="macos" hidden><OsMark system="macos" />macOS</span></a>
        </p>
        <p class="ways">
          <a href="#install">Install with curl</a>
          <span aria-hidden="true">|</span>
          <a href="https://github.com/mashhq/mash/tree/main/raycast">Raycast extension</a>
        </p>
      </div>
    </div>
  </div>

  <section class="install" id="install" aria-label="Install from the terminal" data-install>
    <div class="tabs" role="tablist" aria-label="System">
      <span class="tab-on" aria-hidden="true" data-tab-on></span>
      {installs.map(({ system, label }) => (
        <button type="button" role="tab" id={`install-tab-${system}`} aria-controls={`install-${system}`}
          aria-selected={system === "macos" ? "true" : "false"} tabindex={system === "macos" ? 0 : -1} data-system={system}>
          <OsMark system={system} />{label}
        </button>
      ))}
    </div>
    {installs.map(({ system, label, prompt, command }) => (
      <div class="command" role="tabpanel" id={`install-${system}`} aria-labelledby={`install-tab-${system}`}
        data-system={system} hidden={system !== "macos"}>
        <span class="panel-name">{label}</span>
        <code><span class="prompt" aria-hidden="true">{prompt}</span> {command}</code>
        <button type="button" class="copy-command" data-copy={command} data-copied={t("mash.copied")}
          aria-label={`${t("mash.copy")}: ${label}`}>
          <LineIcon name="copy" size="0.9375rem" /><span data-label>{t("mash.copy")}</span>
        </button>
      </div>
    ))}
  </section>
</div>

<script>
  import { desktopDownload } from "../download.ts";
  import { slideIndicator } from "../slide.ts";

  const keys: Record<string, string> = { macOS: "macos", Windows: "windows", Linux: "linux" };
  const names: Record<string, string> = { macos: "Mac", windows: "Windows", linux: "Linux" };

  /** Shows the install tab for `system` and hides the others. */
  function choose(section: HTMLElement, system: string, focus = false): void {
    for (const tab of section.querySelectorAll<HTMLButtonElement>("[role=tab]")) {
      const on = tab.dataset.system === system;
      tab.setAttribute("aria-selected", String(on));
      tab.tabIndex = on ? 0 : -1;
      if (on && focus) tab.focus();
    }
    for (const panel of section.querySelectorAll<HTMLElement>("[role=tabpanel]"))
      panel.hidden = panel.dataset.system !== system;
  }

  function mountInstall(section: HTMLElement, system: string): void {
    section.classList.add("ready");
    choose(section, system);
    if (section.dataset.mounted) return;
    section.dataset.mounted = "true";
    // The butter highlight slides to the tab chosen; it starts on this one.
    const row = section.querySelector<HTMLElement>("[role=tablist]");
    const highlight = row?.querySelector<HTMLElement>("[data-tab-on]");
    if (row && highlight)
      slideIndicator(row, highlight, {
        chosen: ':scope > [aria-selected="true"]',
        watch: ["aria-selected"],
      });
    const tabs = () => [...section.querySelectorAll<HTMLButtonElement>("[role=tab]")];
    section.addEventListener("click", (event) => {
      const tab = (event.target as Element).closest<HTMLButtonElement>("[role=tab]");
      if (tab?.dataset.system) choose(section, tab.dataset.system);
    });
    // The arrow keys, Home and End move between the tabs, as in any tab list.
    section.addEventListener("keydown", (event) => {
      const list = tabs();
      const at = list.findIndex((tab) => tab === document.activeElement);
      if (at < 0) return;
      const steps: Record<string, number> = { ArrowRight: 1, ArrowLeft: -1, Home: -at, End: list.length - 1 - at };
      const step = steps[event.key];
      if (step === undefined) return;
      event.preventDefault();
      const next = list[(at + step + list.length) % list.length];
      if (next?.dataset.system) choose(section, next.dataset.system, true);
    });
  }

  // Runs on the first load and after each page change.
  document.addEventListener("astro:page-load", () => {
    const download = desktopDownload(navigator);
    const system = (download && keys[download.system]) ?? "macos";
    for (const link of document.querySelectorAll<HTMLAnchorElement>("[data-download]")) {
      if (!download) continue;
      link.href = download.href;
      link.dataset.system = system;
      const label = link.querySelector("[data-download-label]");
      if (label) label.textContent = `Download for ${names[system]}`;
    }
    // "Also on" names the two systems the button does not.
    for (const also of document.querySelectorAll<HTMLElement>("[data-also]")) {
      const others = ["macos", "windows", "linux"].filter((name) => name !== system);
      for (const span of also.querySelectorAll<HTMLElement>("[data-also-system]"))
        span.hidden = !others.includes(span.dataset.alsoSystem ?? "");
      const [first, second] = others.map((name) => also.querySelector(`[data-also-system="${name}"]`));
      const and = also.querySelector("[data-also-and]");
      if (first && second && and) also.append(first, and, second);
    }
    for (const section of document.querySelectorAll<HTMLElement>("[data-install]")) mountInstall(section, system);
  });
</script>

<style>
  /* The hero runs under the header, so the light reaches the top of the
     page; the header itself scrolls away with it (custom.css). */
  .mash-hero {
    position: relative;
    margin-top: calc(-1 * var(--sl-nav-height));
    padding: calc(var(--sl-nav-height) + 3.5rem) var(--mash-gutter) 0;
    overflow: hidden;
  }
  /* The light is faded where the header lies over it and returns to full
     strength a little below, so the header's words keep their contrast
     wherever a streak drifts. */
  .light {
    position: absolute;
    inset: 0 0 auto;
    height: 46rem;
    pointer-events: none;
    mask-image: linear-gradient(#0000004d var(--sl-nav-height), #000 calc(var(--sl-nav-height) + 5rem));
  }
  /* Streaks of butter light, blurred and tilted, drawn in CSS. */
  .streak {
    position: absolute;
    border-radius: var(--radius-pill);
    filter: blur(46px);
    transform: rotate(-24deg);
  }
  .s1 {
    left: -12%;
    top: 3.75rem;
    width: 62%;
    height: 8.125rem;
    background: var(--streak-1);
  }
  .s2 {
    left: 44%;
    top: 0.625rem;
    width: 70%;
    height: 6.875rem;
    background: var(--streak-2);
  }
  .s3 {
    left: 52%;
    top: 18.75rem;
    width: 58%;
    height: 5.625rem;
    background: var(--streak-3);
  }
  .s4 {
    left: -6%;
    top: 26.25rem;
    width: 48%;
    height: 5rem;
    background: var(--streak-4);
  }
  .veil {
    position: absolute;
    left: 50%;
    top: 9.375rem;
    width: 47.5rem;
    max-width: 90%;
    height: 23.75rem;
    transform: translateX(-50%);
    border-radius: var(--radius-round);
    background: var(--hero-veil);
  }
  .hero {
    position: relative;
    max-width: 60rem;
    margin-inline: auto;
  }
  .copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.375rem;
    text-align: center;
  }
  .copy > :global(*) {
    margin: 0;
  }
  /* The app icon, large over the headline as product pages show theirs. */
  .copy > :global(.hero-icon) {
    width: 7rem;
    margin-bottom: 0.875rem;
  }
  h1 {
    color: var(--text-strong);
    font-size: clamp(3rem, 7.4vw, 6rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.055em;
    text-wrap: balance;
  }
  h1 > span {
    display: block;
  }
  /* The claim keeps to one line, so the stroke under it is as wide as its
     words. The stroke hangs below the baseline, outside the flow: nothing
     moves to make room for it. */
  .accent {
    /* The stroke is the brand's own butter. */
    --rule: var(--brand-pat);
    position: relative;
    display: inline-block;
    white-space: nowrap;
  }
  .rule {
    position: absolute;
    top: 0.86em;
    left: 0;
    width: 100%;
    height: 0.24em;
    overflow: visible;
    fill: var(--rule);
    pointer-events: none;
  }
  /* On a screen too narrow for the claim's one line the words wrap again,
     and an ordinary underline in the same colour follows them line by line. */
  @media (width < 17.5rem) {
    .accent {
      display: inline;
      white-space: normal;
      text-decoration: underline var(--rule) 0.06em;
      text-underline-offset: 0.1em;
    }
    .rule {
      display: none;
    }
  }
  /* The mask's line is a little over 300 long: one dash of 310 covers it,
     and offset by as much it uncovers nothing. */
  .draw {
    stroke-dasharray: 310;
    stroke-dashoffset: 0;
  }
  .mash-hero[data-motion="pending"] .draw {
    stroke-dashoffset: 310;
  }
  /* Waiting for the entrance: only the script sets this, and it or the
     motion takes it away again. */
  .mash-hero[data-motion="pending"] :is(:global(.hero-icon), h1 > span, .tagline, .actions, .download-note) {
    opacity: 0;
  }
  .tagline {
    max-width: 42.5rem;
    color: var(--text-secondary);
    font-size: 1.125rem;
    line-height: 1.5;
  }
  /* The docs, as the paragraph's last words: bold, and never split from its arrow. */
  .tagline .docs {
    color: var(--text-strong);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    white-space: nowrap;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 0.625rem;
  }
  .download,
  .try {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5625rem;
    height: 3rem;
    padding: 0 1.375rem;
    border-radius: var(--radius-6);
    background: var(--action-bg);
    box-shadow: var(--shadow-button-lift);
    color: var(--action-text);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
  }
  .download:hover {
    background: var(--action-hover-bg);
  }
  /* The demo, beside the download: the same size, on a raised surface with a
     hairline ring instead of ink. */
  .try {
    background: var(--surface-raised);
    box-shadow: var(--shadow-ring);
    color: var(--text-strong);
  }
  .try:hover {
    background: var(--surface-muted);
  }
  .download :global(.os-mark) {
    width: 1.0625rem;
    height: 1.0625rem;
  }
  .download:not([data-system="macos"]) :global(.os-mark[data-system="macos"]),
  .download:not([data-system="windows"]) :global(.os-mark[data-system="windows"]),
  .download:not([data-system="linux"]) :global(.os-mark[data-system="linux"]) {
    display: none;
  }
  .download-note {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    color: var(--text-secondary);
    font: 400 0.75rem / 1.5 var(--type-mono);
  }
  .download-note p {
    margin: 0;
  }
  .download-note a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--link-underline-quiet);
    text-underline-offset: 3px;
  }
  .download-note a:hover {
    color: var(--text-strong);
    text-decoration-color: var(--link-underline);
  }
  .download-note :global(.os-mark) {
    width: 0.75rem;
    height: 0.75rem;
    margin-inline-end: 0.3125rem;
    vertical-align: -0.125rem;
    opacity: 0.8;
  }
  .download-note [hidden] {
    display: none;
  }
  .ways {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 0.5rem;
  }

  /* The terminal install: tabs with each system's mark over one command. */
  .install {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.875rem;
    max-width: 57rem;
    margin: 7rem auto 0;
    scroll-margin-top: 2rem;
  }
  .tabs {
    position: relative;
    display: none;
    gap: 0.25rem;
    padding: 0.25rem;
    border-radius: var(--radius-6);
    background: var(--surface-muted);
    box-shadow: var(--shadow-ring-inset);
  }
  .ready .tabs {
    display: flex;
  }
  .tabs button {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.4375rem;
    height: 2rem;
    margin: 0;
    padding: 0 1rem;
    border: 0;
    border-radius: var(--radius-4);
    background: transparent;
    color: var(--text-secondary);
    font: 500 0.8125rem / 1 var(--type-sans);
    cursor: pointer;
    transition: color 200ms ease-out;
  }
  .tabs button:hover {
    color: var(--text-strong);
  }
  .tabs button[aria-selected="true"] {
    background: var(--butter);
    box-shadow: var(--shadow-tab-on);
    color: var(--text-on-butter);
    font-weight: 600;
  }
  /* The chosen tab's highlight, slid across to it (slide.ts); the tab then
     leaves its own background to it. On this page it moves for everyone. */
  .tab-on {
    position: absolute;
    top: 0;
    left: 0;
    display: none;
    border-radius: var(--radius-4);
    background: var(--butter);
    box-shadow: var(--shadow-tab-on);
    pointer-events: none;
    transition:
      transform 200ms ease-out,
      width 200ms ease-out;
  }
  .tabs[data-sliding] .tab-on {
    display: block;
  }
  .tabs[data-sliding] button[aria-selected="true"] {
    background: none;
    box-shadow: none;
  }
  .tabs :global(.os-mark) {
    width: 0.875rem;
    height: 0.875rem;
    opacity: 0.85;
  }
  .command {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    box-sizing: border-box;
    padding: 0.5rem 0.5rem 0.5rem 1.125rem;
    border-radius: var(--radius-7);
    background: var(--surface-raised);
    box-shadow: var(--shadow-float);
  }
  .command[hidden] {
    display: none;
  }
  /* Without the script every system's command shows, each named. */
  .install:not(.ready) .command[hidden] {
    display: flex;
  }
  .install:not(.ready) {
    gap: 0.625rem;
  }
  .panel-name {
    display: none;
    flex: none;
    color: var(--text-faint);
    font: 500 0.75rem / 1 var(--type-sans);
  }
  .install:not(.ready) .panel-name {
    display: block;
  }
  .command code {
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    color: var(--text-strong);
    font: 400 0.8125rem / 1.6 var(--type-mono);
    white-space: nowrap;
    scrollbar-width: thin;
  }
  .prompt {
    color: var(--butter-icon);
  }
  .copy-command {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 0.375rem;
    height: 2.25rem;
    margin: 0;
    padding: 0 0.625rem;
    border: 0;
    border-radius: var(--radius-4);
    background: transparent;
    color: var(--text-secondary);
    font: 500 0.75rem / 1 var(--type-sans);
    cursor: pointer;
  }
  .copy-command:hover {
    background: var(--surface-hover);
    color: var(--text-strong);
  }

  @media (width < 40rem) {
    .mash-hero {
      padding-top: calc(var(--sl-nav-height) + 2rem);
    }
    .copy > :global(.hero-icon) {
      width: 4.5rem;
      margin-bottom: 0.375rem;
    }
    h1 {
      font-size: clamp(2.5rem, 12vw, 3rem);
    }
    /* The two buttons stack across the column, the download first. */
    .actions {
      flex-direction: column;
      align-self: stretch;
    }
    /* The ways in wrap here, so a wider gap parts them instead of bars,
       which would be left hanging at the end of a line. */
    .ways {
      gap: 0 1rem;
    }
    .ways span {
      display: none;
    }
    .install {
      margin-top: 4.5rem;
    }
    .tabs button {
      padding: 0 0.75rem;
    }
    .copy-command [data-label] {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
  }
</style>
