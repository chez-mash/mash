---
// The landing hero: a stamp, Starlight's headline, tagline and actions on
// the left, led by the desktop app's download for the visitor's system, and
// on the right a handoff between two agents told with sticker cards. Other
// ways to install, including asking an agent, are in the docs.
import { Icon, LinkButton } from "@astrojs/starlight/components";

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero ?? {};
---
<div class="mash-hero">
  <div class="hero">
    <div class="copy">
      <img class="hero-mark" src="/mash-mark.svg" alt="" width="112" height="112" />
      <span class="mash-stamp">Open source · self-hosted</span>
      <h1 id="_top" data-page-title set:html={title} />
      {
        tagline && (
          <p class="tagline">
            <Fragment set:html={tagline} />
          </p>
        )
      }
      {
        actions.length > 0 && (
          <div class="actions">
            {/* The desktop app for the visitor's system, chosen by the script
                below; without it, the link opens the downloads page. */}
            <a class="sl-link-button not-content primary download" href="/downloads/#desktop-app" data-download>
              <Icon name="download" size="1.25rem" />
              <span data-download-label>Download Mash</span>
            </a>
            {actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link, text, variant }) => (
              <LinkButton href={link} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
                {text}
                {icon?.html && <Fragment set:html={icon.html} />}
              </LinkButton>
            ))}
          </div>
        )
      }
      <p class="download-note">
        Free and open source. <a href="/downloads/#desktop-app">Other systems</a>{" · "}<a
          href="/quick-start/#install-it-yourself">Install from a terminal or with your agent</a
        >
      </p>
    </div>
    <div class="handoff" aria-hidden="true">
      <div class="sticker claude">
        <p class="who"><span class="mash-agent-tile" data-agent="claude-code"></span><b>Claude Code</b><span>laptop · 10:01</span></p>
        <p>Sign-in now uses fifteen-minute access tokens.</p>
      </div>
      <div class="sticker decision">
        <p class="who"><Icon name="approve-check-circle" size="1rem" /><b>Decision saved in Mash</b><span class="mash-pill ok">Accepted</span></p>
        <p><b>Sign-in uses fifteen-minute access tokens with a server-held refresh token.</b></p>
      </div>
      <div class="sticker codex">
        <p class="who"><span class="mash-agent-tile" data-agent="codex"></span><b>Codex</b><span>workstation · 4 hours later</span></p>
        <p>Found the decision in Mash. Moving the refresh token into the device keychain.</p>
      </div>
      <div class="sticker mashy">
        <img src="/mashy.png" alt="" width="46" height="42" />
        <span>Nobody had to explain it twice.</span>
      </div>
    </div>
  </div>

</div>

<script>

  import { desktopDownload } from "../download.ts";

  // Runs on the first load and after each page change.
  document.addEventListener("astro:page-load", () => {
    const download = desktopDownload(navigator);
    for (const link of document.querySelectorAll<HTMLAnchorElement>("[data-download]")) {
      if (!download) continue;
      link.href = download.href;
      const label = link.querySelector("[data-download-label]");
      if (label) label.textContent = `Download for ${download.system}`;
    }
  });
</script>

<style>
  /* The hero is a band of its own: the words and actions on the left, the
     sticker cards on the right, and the setup window under both. */
  .mash-hero {
    padding: 5.25rem var(--mash-gutter) 4rem;
    border-bottom: var(--border-outline);
  }
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: 3.5rem;
    align-items: center;
    max-width: var(--mash-wrapper);
    margin-inline: auto;
  }
  .copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
  }
  .copy > :global(*) {
    margin: 0;
  }
  /* Under the actions: where the other systems' downloads are. */
  .copy .download-note {
    margin-top: -0.5rem;
    color: var(--text-muted);
    font-size: 0.9375rem;
  }
  .download-note a {
    color: var(--link);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--link-underline);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }
  /* A plain link drawn as Starlight's button, so it reads as one. */
  .actions .download {
    text-decoration: none;
  }
  /* The Mash logo, large, at the top of the page. */
  .hero-mark {
    display: block;
    width: 7rem;
    height: 7rem;
  }
  h1 {
    color: var(--text-ink);
    font-size: clamp(2.75rem, 1.5rem + 4vw, 4.25rem);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.05em;
  }
  h1 :global(span) {
    display: block;
  }
  /* The answer is ink, under a butter highlighter stroke. */
  h1 :global(.mash-turn) {
    display: inline;
    background: linear-gradient(transparent 62%, var(--fill-butter) 62%, var(--fill-butter) 92%, transparent 92%);
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }
  .tagline {
    max-width: 35rem;
    color: var(--text-body);
    font-size: 1.1875rem;
    line-height: 1.5;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
  }
  .actions :global(.sl-link-button) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4375rem;
    height: 2.875rem;
    margin: 0;
    padding: 0 1.25rem;
    border: var(--border-outline);
    border-radius: var(--radius-large);
    background: var(--surface-paper);
    color: var(--text-ink);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1;
  }
  .actions :global(.sl-link-button.primary) {
    border-color: var(--line-ink);
    background: var(--fill-peach);
    color: var(--text-on-fill);
  }
  .actions :global(.sl-link-button:hover) {
    background: var(--surface-cream);
  }
  .actions :global(.sl-link-button.primary:hover) {
    background: var(--action-hover-bg);
  }

  /* A label stamped on the page: upright, in mono capitals. */
  .mash-stamp {
    display: inline-flex;
    align-items: center;
    padding: 0.3125rem 0.75rem;
    border: var(--border-outline);
    border-radius: var(--radius-2);
    background: var(--surface-paper);
    color: var(--text-ink);
    font: 700 0.75rem/1 var(--type-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* The handoff: cards stuck at staggered insets, like stickers. */
  .handoff {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    font-size: 0.875rem;
  }
  .sticker {
    padding: 0.75rem 0.875rem;
    border: var(--border-outline);
    border-radius: var(--radius-3);
    background: var(--surface-paper);
    color: var(--text-ink);
  }
  .sticker p {
    margin: 0;
  }
  .sticker .who {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    margin-bottom: 0.5rem;
    font-size: 0.78125rem;
  }
  .sticker .who > span:last-child:not(.mash-pill) {
    color: var(--text-muted);
  }
  .sticker .who :global(.mash-agent-tile) {
    width: 1.25rem;
    height: 1.25rem;
    margin: 0;
    border-radius: var(--radius-1);
  }
  .sticker.claude {
    margin-inline-end: 3.5rem;
  }
  .sticker.decision {
    margin-inline-start: 2.5rem;
    border-color: var(--line-ink);
    background: var(--fill-butter);
    color: var(--text-on-fill);
  }
  .sticker.decision .mash-pill {
    margin-inline-start: auto;
  }
  .sticker.codex {
    margin-inline: 1.5rem;
  }
  .sticker.mashy {
    display: flex;
    align-items: center;
    gap: 0.6875rem;
    align-self: flex-end;
    max-width: 18.75rem;
    margin-top: 0.25rem;
    padding: 0.625rem 0.75rem;
    border-color: var(--line-ink);
    background: var(--fill-lilac);
    color: var(--text-on-fill);
    font-size: 0.78125rem;
  }
  .sticker.mashy img {
    width: 2.875rem;
    height: auto;
  }

  @media (width < 62rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
    }
  }
  /* On a phone: the words first, the actions full width and stacked, and the
     sticker cards left out. */
  @media (width < 40rem) {
    .mash-hero {
      padding-block: 2rem 1.75rem;
    }
    .copy {
      gap: 1.125rem;
    }
    .hero-mark {
      width: 5.5rem;
      height: 5.5rem;
    }
    h1 {
      font-size: 2.75rem;
    }
    .tagline {
      font-size: 1.0625rem;
    }
    .handoff {
      display: none;
    }
    .actions {
      flex-direction: column;
      align-self: stretch;
      gap: 0.6875rem;
    }
    .actions :global(.sl-link-button) {
      width: 100%;
    }
  }
</style>
