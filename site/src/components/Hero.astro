---
// The landing hero: a stamp, Starlight's headline, tagline and actions on
// the left, and on the right a handoff between two agents told with sticker
// cards. Under both, a window that hands setup to a coding agent or shows the
// install command for the visitor's system.
import { Icon, LinkButton } from "@astrojs/starlight/components";

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero ?? {};
// What a visitor pastes into a coding agent to have it do the setup.
const ask =
  "Read https://getmash.io/setup.md and set up Mash on this machine. Review the choices with me first.";

const cargo = {
  id: "cargo",
  label: "Cargo",
  prompt: "$",
  command: "cargo +stable install --locked --git https://github.com/mashium/mash mash",
  requirements: "Requires Git and a stable Rust toolchain installed with rustup.",
};
const brew = {
  id: "brew",
  label: "Homebrew",
  prompt: "$",
  command: "brew install mashium/tap/mash",
  requirements: "Requires an Apple silicon Mac and Homebrew.",
};
const apt = {
  id: "apt",
  label: "apt",
  prompt: "$",
  command:
    'curl -fsSL https://getmash.io/apt/mash-archive-keyring.gpg | sudo tee /usr/share/keyrings/mash-archive-keyring.gpg >/dev/null && echo "deb [signed-by=/usr/share/keyrings/mash-archive-keyring.gpg] https://getmash.io/apt stable main" | sudo tee /etc/apt/sources.list.d/mash.list && sudo apt update && sudo apt install mash-cli',
  requirements: "For Debian 12+ or Ubuntu 22.04+ on x86-64 or ARM64. Requires sudo.",
};
const script = {
  id: "script",
  label: "Script",
  prompt: "$",
  command:
    "curl -fsSL https://raw.githubusercontent.com/mashium/mash/main/install.sh | sh -s -- --dashboard",
  requirements: "For Apple silicon Macs. Run in Terminal.",
};
const systems = [
  { id: "macos", label: "macOS", icon: "apple", methods: [script, brew, cargo] },
  {
    id: "linux",
    label: "Linux",
    icon: "linux",
    methods: [
      {
        ...script,
        requirements:
          "For Linux or WSL on x86-64 or ARM64 with glibc 2.34+. Requires a systemd user session.",
      },
      apt,
      cargo,
    ],
  },
  {
    id: "windows",
    label: "Windows",
    icon: "seti:windows",
    methods: [
      {
        id: "script",
        label: "PowerShell",
        prompt: ">",
        command:
          "& ([scriptblock]::Create((irm https://raw.githubusercontent.com/mashium/mash/main/install.ps1))) -Dashboard",
        requirements: "For Windows x64. Open PowerShell after signing in to the Windows desktop.",
      },
      {
        id: "scoop",
        label: "Scoop",
        prompt: ">",
        command:
          "scoop bucket add mashium https://github.com/mashium/mash; scoop install mashium/mash",
        requirements: "Requires Windows x64 and Scoop. Run in PowerShell.",
      },
      cargo,
    ],
  },
];
// Each install method's mark, by its id, or by system and id where one
// system's differs. apt and Scoop have no mark in the
// icon set, so they share the download arrow.
const methodIcons = {
  script: "seti:shell",
  "windows:script": "seti:powershell",
  brew: "homebrew",
  apt: "download",
  scoop: "download",
  cargo: "seti:rust",
} as const;
const first = script;
---
<div class="mash-hero">
  <div class="hero">
    <div class="copy">
      <img class="hero-mark" src="/mash-mark.svg" alt="" width="112" height="112" />
      <span class="mash-stamp">Open source · self-hosted</span>
      <h1 id="_top" data-page-title set:html={title} />
      {
        tagline && (
          <p class="tagline">
            <Fragment set:html={tagline} />
          </p>
        )
      }
      {
        actions.length > 0 && (
          <div class="actions">
            {actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link, text, variant }) => (
              <LinkButton href={link} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
                {text}
                {icon?.html && <Fragment set:html={icon.html} />}
              </LinkButton>
            ))}
          </div>
        )
      }
    </div>
    <div class="handoff" aria-hidden="true">
      <div class="sticker claude">
        <p class="who"><span class="mash-agent-tile" data-agent="claude-code"></span><b>Claude Code</b><span>laptop · 10:01</span></p>
        <p>Sign-in now uses fifteen-minute access tokens.</p>
      </div>
      <div class="sticker decision">
        <p class="who"><Icon name="approve-check-circle" size="1rem" /><b>Decision saved in Mash</b><span class="mash-pill ok">Accepted</span></p>
        <p><b>Sign-in uses fifteen-minute access tokens with a server-held refresh token.</b></p>
      </div>
      <div class="sticker codex">
        <p class="who"><span class="mash-agent-tile" data-agent="codex"></span><b>Codex</b><span>workstation · 4 hours later</span></p>
        <p>Found the decision in Mash. Moving the refresh token into the device keychain.</p>
      </div>
      <div class="sticker mashy">
        <img src="/mashy.png" alt="" width="46" height="42" />
        <span>Nobody had to explain it twice.</span>
      </div>
    </div>
  </div>

  <div class="mash-install" data-systems={JSON.stringify(systems)}>
    <div class="window-h">
      <div class="choice mode" role="group" aria-label="How to set up" data-pick="mode">
        <button type="button" value="agent" aria-pressed="true">
          <Icon name="comment" size="0.9375rem" />
          Ask your agent
        </button>
        <button type="button" value="manual" aria-pressed="false">
          <Icon name="seti:shell" size="0.9375rem" />
          Install<span class="long"> it yourself</span>
        </button>
      </div>
      <div class="choices">
        <div class="choice" role="group" aria-label="Operating system" data-pick="system">
          {
            systems.map((system) => (
              <button type="button" value={system.id} aria-pressed="false">
                <Icon name={system.icon} size="0.9375rem" />
                <span class="label">{system.label}</span>
              </button>
            ))
          }
        </div>
        <div class="choice" role="group" aria-label="Install method" data-pick="method"></div>
        {
          Object.entries(methodIcons).map(([id, name]) => (
            <template data-method-icon={id}>
              <Icon name={name} size="0.9375rem" />
            </template>
          ))
        }
      </div>
    </div>
    <div class="window-b">
      <h2>Paste into your coding agent</h2>
      <div class="command agent">
        <code class="wrap">{ask}</code>
        <button type="button" data-copy={ask} aria-label="Copy the prompt for your agent">Copy</button>
      </div>
      <h2>or install it yourself</h2>
      <p class="manual-guide"><a href="/installation/#get-mash-for-your-system">See the install steps for your operating system</a>.</p>
      <p class="requirements">
        <span data-requirements>{first.requirements}</span>
        <a class="linux-setup" href="/local-search/#linux-without-a-systemd-user-session">Linux setup without systemd</a>
      </p>
      <div class="command picked">
        <span class="prompt" aria-hidden="true">{first.prompt}</span>
        <code>{first.command}</code>
        <button type="button" data-copy={first.command} aria-label="Copy the install command">Copy</button>
      </div>
      <p class="script-hint">
        Installs Mash and starts local search and the dashboard. Open the address it prints to choose
        which chats to index and whether to connect any agents.
        <a href="/dashboard/#set-up-mash-from-the-dashboard">See browser setup</a> · <a href="/installation/">Install separately</a>
      </p>
      <p class="package-hint">
        Includes the browser dashboard. After installing,
        <a href="/installation/#start-the-local-search-service">start the local search service and choose which histories to read</a>.
        <a href="/install-methods/#install-with-a-package-manager">Review the package sources</a>.
      </p>
      <p class="cargo-hint">
        This command installs terminal search and agent tools.
        <a href="/installation/#start-the-local-search-service">Set up terminal search</a> or
        <a href="/install-methods/#include-the-web-dashboard">Build with the dashboard</a> to search in your browser.
        <a href="/install-methods/#cli-and-agent-tools">Review the source build</a>.
      </p>
    </div>
  </div>
  <p class="hint">Paste it into a coding agent. You choose whether to connect agents or start with the dashboard.</p>
</div>

<script>
  import { mountInstall } from "../install.ts";

  // Runs on the first load and after each page change.
  document.addEventListener("astro:page-load", () => {
    for (const picker of document.querySelectorAll<HTMLElement>(".mash-install")) mountInstall(picker);
  });
</script>

<style>
  /* The hero is a band of its own: the words and actions on the left, the
     sticker cards on the right, and the setup window under both. */
  .mash-hero {
    padding: 5.25rem var(--mash-gutter) 4rem;
    border-bottom: var(--border-outline);
  }
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: 3.5rem;
    align-items: center;
    max-width: var(--mash-wrapper);
    margin-inline: auto;
  }
  .copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
  }
  .copy > :global(*) {
    margin: 0;
  }
  /* The Mash logo, large, at the top of the page. */
  .hero-mark {
    display: block;
    width: 7rem;
    height: 7rem;
  }
  h1 {
    color: var(--text-ink);
    font-size: clamp(2.75rem, 1.5rem + 4vw, 4.25rem);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.05em;
  }
  h1 :global(span) {
    display: block;
  }
  /* The answer is ink, under a butter highlighter stroke. */
  h1 :global(.mash-turn) {
    display: inline;
    background: linear-gradient(transparent 62%, var(--fill-butter) 62%, var(--fill-butter) 92%, transparent 92%);
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }
  .tagline {
    max-width: 35rem;
    color: var(--text-body);
    font-size: 1.1875rem;
    line-height: 1.5;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
  }
  .actions :global(.sl-link-button) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4375rem;
    height: 2.875rem;
    margin: 0;
    padding: 0 1.25rem;
    border: var(--border-outline);
    border-radius: var(--radius-large);
    background: var(--surface-paper);
    color: var(--text-ink);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1;
  }
  .actions :global(.sl-link-button.primary) {
    border-color: var(--line-ink);
    background: var(--fill-peach);
    color: var(--text-on-fill);
  }
  .actions :global(.sl-link-button:hover) {
    background: var(--surface-cream);
  }
  .actions :global(.sl-link-button.primary:hover) {
    background: var(--action-hover-bg);
  }

  /* A label stamped on the page: upright, in mono capitals. */
  .mash-stamp {
    display: inline-flex;
    align-items: center;
    padding: 0.3125rem 0.75rem;
    border: var(--border-outline);
    border-radius: var(--radius-2);
    background: var(--surface-paper);
    color: var(--text-ink);
    font: 700 0.75rem/1 var(--type-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* The handoff: cards stuck at staggered insets, like stickers. */
  .handoff {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    font-size: 0.875rem;
  }
  .sticker {
    padding: 0.75rem 0.875rem;
    border: var(--border-outline);
    border-radius: var(--radius-3);
    background: var(--surface-paper);
    color: var(--text-ink);
  }
  .sticker p {
    margin: 0;
  }
  .sticker .who {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    margin-bottom: 0.5rem;
    font-size: 0.78125rem;
  }
  .sticker .who > span:last-child:not(.mash-pill) {
    color: var(--text-muted);
  }
  .sticker .who :global(.mash-agent-tile) {
    width: 1.25rem;
    height: 1.25rem;
    margin: 0;
    border-radius: var(--radius-1);
  }
  .sticker.claude {
    margin-inline-end: 3.5rem;
  }
  .sticker.decision {
    margin-inline-start: 2.5rem;
    border-color: var(--line-ink);
    background: var(--fill-butter);
    color: var(--text-on-fill);
  }
  .sticker.decision .mash-pill {
    margin-inline-start: auto;
  }
  .sticker.codex {
    margin-inline: 1.5rem;
  }
  .sticker.mashy {
    display: flex;
    align-items: center;
    gap: 0.6875rem;
    align-self: flex-end;
    max-width: 18.75rem;
    margin-top: 0.25rem;
    padding: 0.625rem 0.75rem;
    border-color: var(--line-ink);
    background: var(--fill-lilac);
    color: var(--text-on-fill);
    font-size: 0.78125rem;
  }
  .sticker.mashy img {
    width: 2.875rem;
    height: auto;
  }

  /* The setup window: a cream title bar holding the choices, then the prompt
     or command, wrapped rather than cut off. */
  .mash-install {
    max-width: 51.25rem;
    margin: 3.5rem auto 0;
    overflow: hidden;
    border: var(--border-outline);
    border-radius: var(--radius-3);
    background: var(--surface-paper);
  }
  .window-h {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    padding: 0.6875rem 1rem;
    border-bottom: var(--border-outline);
    background: var(--surface-cream);
  }
  .mash-install[data-mode="manual"] .window-h {
    justify-content: flex-start;
  }
  .choices {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin-inline-start: auto;
  }
  .window-b {
    display: grid;
    gap: 0.625rem;
    padding: 1rem 1.125rem;
  }
  .window-b > :global(*) {
    margin: 0;
  }
  /* Segmented controls: outlined, with the chosen part in butter. */
  .choice {
    display: inline-flex;
    overflow: hidden;
    border: var(--border-outline);
    border-radius: var(--radius-2);
    background: var(--surface-paper);
  }
  .choice:empty {
    display: none;
  }
  .choice :global(button) {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.3125rem 0.6875rem;
    border: 0;
    background: none;
    color: var(--text-ink);
    font: 600 0.8125rem var(--type-sans);
    white-space: nowrap;
    cursor: pointer;
  }
  .choice :global(button + button) {
    border-inline-start: var(--border-outline);
  }
  .choice :global(button:hover) {
    background: var(--surface-cream);
  }
  .choice :global(button[aria-pressed="true"]) {
    background: var(--fill-butter);
    color: var(--text-on-fill);
  }
  /* Without scripting, show the agent prompt and link to the manual steps. */
  .mash-install:not([data-mode]) .window-h,
  .mash-install:not([data-mode]) .requirements,
  .mash-install:not([data-mode]) .picked,
  .mash-install:not([data-mode]) .command button,
  .mash-install[data-mode] .manual-guide,
  .mash-install[data-mode] h2,
  .mash-install[data-mode="agent"] .choices,
  .mash-install[data-mode="agent"] .requirements,
  .mash-install[data-mode="agent"] .picked,
  .mash-install[data-mode="manual"] .command.agent {
    display: none;
  }
  .command {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    min-width: 0;
    font-family: var(--type-mono);
    font-size: 0.84375rem;
    line-height: 1.6;
  }
  .prompt {
    align-self: flex-start;
    color: var(--text-muted);
    user-select: none;
  }
  code {
    flex: 1;
    min-width: 0;
    padding: 0;
    background: none;
    color: var(--text-ink);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .command button {
    flex: none;
    height: 2.25rem;
    padding: 0 0.8125rem;
    border: var(--stroke-outline) solid var(--line-ink);
    border-radius: var(--radius-2);
    background: var(--fill-butter);
    color: var(--text-on-fill);
    font: 600 0.875rem var(--type-sans);
    cursor: pointer;
  }
  .command button:hover {
    background: var(--command-button-hover-bg);
  }
  .script-hint,
  .package-hint,
  .cargo-hint,
  .linux-setup {
    display: none;
  }
  .mash-install[data-mode="manual"][data-system="linux"][data-method="script"] .linux-setup {
    display: inline;
  }
  .mash-install[data-mode="manual"][data-method="script"] .script-hint,
  .mash-install[data-mode="manual"][data-method="cargo"] .cargo-hint,
  .mash-install[data-mode="manual"][data-method]:not([data-method="script"], [data-method="cargo"]) .package-hint {
    display: block;
  }
  .mash-install p,
  .hint {
    color: var(--text-muted);
    font-size: 0.8125rem;
  }
  .mash-install h2 {
    color: var(--text-body);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0;
  }
  .mash-install a {
    color: var(--link);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--link-underline);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }
  .hint {
    max-width: 51.25rem;
    margin: 0.875rem auto 0;
    text-align: center;
  }
  .mash-install[data-mode="manual"] + .hint {
    display: none;
  }

  @media (width < 62rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
    }
  }
  /* On a phone: the words first, the actions full width and stacked, and the
     sticker cards left out; the setup window keeps its two tabs. */
  @media (width < 40rem) {
    .mash-hero {
      padding-block: 2rem 1.75rem;
    }
    .copy {
      gap: 1.125rem;
    }
    .hero-mark {
      width: 5.5rem;
      height: 5.5rem;
    }
    h1 {
      font-size: 2.75rem;
    }
    .tagline {
      font-size: 1.0625rem;
    }
    .handoff {
      display: none;
    }
    .actions {
      flex-direction: column;
      align-self: stretch;
      gap: 0.6875rem;
    }
    .actions :global(.sl-link-button) {
      width: 100%;
    }
    .mash-install {
      margin-top: 1.25rem;
    }
    .window-h {
      padding: 0.5625rem 0.75rem;
    }
    .long {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .choices {
      margin-inline-start: 0;
    }
    .choice[data-pick="system"] .label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .choice[data-pick="method"] :global(svg) {
      display: none;
    }
    .command {
      flex-wrap: wrap;
    }
    .command code {
      flex-basis: calc(100% - 2rem);
    }
    .command.agent code {
      flex-basis: 100%;
    }
  }
</style>
