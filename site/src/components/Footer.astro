---
// The landing page ends with the project's name and a few ways onward; every
// other page keeps Starlight's footer.
import Default from "@astrojs/starlight/components/Footer.astro";

const { entry, locale } = Astro.locals.starlightRoute;
const home = entry.data.template === "splash";
// The links lead to the guides in the reader's language. A guide that is not
// translated yet still has a page there, which shows the English text.
const base = locale ? `/${locale}/` : "/";
---

{
  home ? (
    <footer class="mash-footer">
      <span class="name">
        <img src="/mash-mark.svg" alt="" width="26" height="26" />
        mash
      </span>
      <nav aria-label={Astro.locals.t("mash.footer.label")}>
        <a href={`${base}guides/`}>{Astro.locals.t("mash.nav.docs")}</a>
        <a href="/demo/" data-astro-reload>{Astro.locals.t("mash.nav.demo")}</a>
        <a href={`${base}privacy/`}>{Astro.locals.t("mash.footer.privacy")}</a>
        <a href={`${base}troubleshooting/`}>{Astro.locals.t("mash.footer.help")}</a>
        <a href="https://github.com/grep-stack/mash">GitHub</a>
      </nav>
    </footer>
  ) : (
    <Default />
  )
}

<style>
  /* A band in the sidebar's deeper beige, ruled off in ink: the brand, then
     the ways onward in bold ink. */
  .mash-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding: 2.75rem max(var(--mash-gutter), calc((100% - var(--mash-wrapper)) / 2)) 2.25rem;
    background: var(--surface-side);
  }
  :global(.sl-container) > .mash-footer {
    margin-top: 4rem;
    border-top: var(--border-outline);
  }
  :global(main:has(.mash-hero)) .mash-footer {
    margin-top: 0;
    border-top: 0;
  }
  .name {
    display: flex;
    align-items: center;
    gap: 0.5625rem;
    color: var(--brand-name);
    font-size: 1.4375rem;
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  .name img {
    width: 1.875rem;
    height: 1.875rem;
  }
  /* As in the header: the name is followed by the cursor, in peach. */
  .name::after {
    content: "_";
    margin-inline-start: -0.5em;
    color: var(--brand-cursor);
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
  }
  nav a {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--text-ink);
    font-weight: 700;
    text-decoration: none;
  }
  nav a:hover {
    text-decoration: underline;
    text-decoration-color: var(--link-underline);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }
</style>
