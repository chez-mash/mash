---
// The landing page ends with the project's name and a few ways onward; every
// other page keeps Starlight's footer.
import Default from "@astrojs/starlight/components/Footer.astro";

const home = Astro.locals.starlightRoute.entry.data.template === "splash";
---

{
  home ? (
    <footer class="mash-footer">
      <span class="name">
        <img class="dark" src="/mash-mark.svg" alt="" width="26" height="26" />
        <img class="light" src="/mash-mark-light.svg" alt="" width="26" height="26" />
        mash
      </span>
      <nav aria-label="Footer">
        <a href="/guides/">Docs</a>
        <a href="/demo/" data-astro-reload>Try it</a>
        <a href="/privacy/">Privacy</a>
        <a href="/troubleshooting/">Get help</a>
        <a href="https://github.com/mashium/mash">GitHub</a>
      </nav>
    </footer>
  ) : (
    <Default />
  )
}

<style>
  /* A band in the sidebar's deeper beige, ruled off in ink: the brand, then
     the ways onward in bold ink. */
  .mash-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding: 2.75rem max(var(--mash-gutter), calc((100% - var(--mash-wrapper)) / 2)) 2.25rem;
    background: var(--surface-side);
  }
  :global(.sl-container) > .mash-footer {
    margin-top: 4rem;
    border-top: var(--border-outline);
  }
  :global(main:has(.mash-hero)) .mash-footer {
    margin-top: 0;
    border-top: 0;
  }
  .name {
    display: flex;
    align-items: center;
    gap: 0.5625rem;
    color: var(--brand-name);
    font-size: 1.4375rem;
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  .name img {
    width: 1.875rem;
    height: 1.875rem;
  }
  /* As in the header: the name is followed by the cursor, in peach. */
  .name::after {
    content: "_";
    margin-inline-start: -0.5em;
    color: var(--brand-cursor);
  }
  .light,
  :global([data-theme="light"]) .dark {
    display: none;
  }
  :global([data-theme="light"]) .light {
    display: block;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
  }
  nav a {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--text-ink);
    font-weight: 700;
    text-decoration: none;
  }
  nav a:hover {
    text-decoration: underline;
    text-decoration-color: var(--link-underline);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }
</style>
