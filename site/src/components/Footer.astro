---
// The landing page and the guides directory end with a quiet line: the project, then a few ways
// onward. Every other page keeps Starlight's footer.
//
// The landing page's line ends with the language menu. Its header has room
// for it only on a wide screen, and on a phone it is the logo alone, so this
// is where a reader on any screen can change it.
import Default from "@astrojs/starlight/components/Footer.astro";
import LanguageSelect from "./LanguageSelect.astro";

const { entry, locale } = Astro.locals.starlightRoute;
const home = entry.data.template === "splash";
const landing = home && entry.data.hero !== undefined;
// The links lead to the guides in the reader's language. A guide that is not
// translated yet still has a page there, which shows the English text.
const base = locale ? `/${locale}/` : "/";
---

{
  home ? (
    <footer class="mash-footer">
      <span class="name">Mash · open source</span>
      <nav aria-label={Astro.locals.t("mash.footer.label")}>
        <a href={`${base}guides/`}>{Astro.locals.t("mash.nav.docs")}</a>
        <a href="/demo/" data-astro-reload>{Astro.locals.t("mash.nav.demo")}</a>
        <a href={`${base}privacy/`}>{Astro.locals.t("mash.footer.privacy")}</a>
        <a href={`${base}troubleshooting/`}>{Astro.locals.t("mash.footer.help")}</a>
        <a href="https://github.com/mashhq/mash">GitHub</a>
      </nav>
      {landing && (
        <div class="prefs">
          <LanguageSelect />
        </div>
      )}
    </footer>
  ) : (
    <Default />
  )
}

<style>
  .mash-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    max-width: 75rem;
    margin-inline: auto;
    padding: 4.5rem var(--mash-gutter) 3rem;
    color: var(--text-faint);
    font-size: 0.8125rem;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
  }
  nav a {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--text-faint);
    text-decoration: none;
  }
  nav a:hover {
    color: var(--text-strong);
  }
  /* The menus are the header's small ghost controls, on a line of their own
     under the links on a phone and at the end of the line on a wide screen. */
  .prefs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1.25rem;
  }
  .prefs :global(label) {
    height: 2.75rem;
    color: var(--text-faint);
  }
  .prefs :global(label:hover) {
    color: var(--text-strong);
  }
  @media (width < 50rem) {
    .prefs {
      flex-basis: 100%;
    }
  }
</style>
