---
// Search across machines: one search asks this computer and the others, and
// lists what each answers with its machine beside it. Drawn as the dashboard
// shows a shared search, from made-up history; one image to assistive
// technology.
import type { Agent } from "../../../dashboard/src/lib/types";
import AgentTile from "./AgentTile.astro";
import LineIcon from "./LineIcon.astro";
import OsMark from "./OsMark.astro";

type System = "macos" | "linux" | "windows";
const machines: { name: string; system: System; state: string; done: boolean }[] = [
  { name: "laptop", system: "macos", state: "this computer", done: true },
  { name: "workstation", system: "linux", state: "answered", done: true },
  { name: "build-box", system: "windows", state: "searching", done: false },
];
const results: {
  agent: Agent;
  title: string;
  line: string;
  machine: string;
  system: System;
  meaning?: boolean;
}[] = [
  {
    agent: "opencode",
    title: "Invoice exports are stuck in the queue",
    line: "Exports with more than 5,000 invoices never leave the queue.",
    machine: "laptop",
    system: "macos",
  },
  {
    agent: "codex",
    title: "Choose a queue for invoice exports",
    line: "A separate queue keeps a large export from holding up the small ones.",
    machine: "workstation",
    system: "linux",
  },
  {
    agent: "claude-code",
    title: "Give long jobs their own workers",
    line: "Long-running work should not share workers with requests.",
    machine: "workstation",
    system: "linux",
    meaning: true,
  },
];
---

<section class="band" id="welcome-machines" aria-labelledby="welcome-machines-title">
  <div class="wrapper split" data-reveal>
    <div class="window machines" role="img"
      aria-label="The search ‘invoice exports queue’ asks three machines at once. The laptop and the workstation have answered with three chats from OpenCode, Codex and Claude Code, one of them found by meaning; the build box is still searching.">
      <div class="window-h" aria-hidden="true"><u></u><u></u><u></u><span>mash · search</span></div>
      <div class="window-b" aria-hidden="true">
        <div class="query"><LineIcon name="search" size="1rem" /><b>invoice exports queue</b></div>
        <p class="asked">
          {machines.map((machine) => (
            <span class:list={["machine", { waiting: !machine.done }]}>
              <OsMark system={machine.system} /><b>{machine.name}</b>{machine.state}
            </span>
          ))}
        </p>
        {results.map((result) => (
          <div class="result">
            <p class="who"><AgentTile agent={result.agent} /><b>{result.title}</b><span><OsMark system={result.system} />{result.machine}</span></p>
            <p>{result.line}{result.meaning && <span class="pill">by meaning</span>}</p>
          </div>
        ))}
      </div>
    </div>
    <div class="words">
      <span class="kicker">Across machines</span>
      <h2 id="welcome-machines-title">Every machine. <span class="quiet">One search.</span></h2>
      <p class="blurb">
        Each computer keeps an index of its own chats and publishes it to a Mash server you run. One
        search asks this computer and the others at once, and each result names the machine it came
        from. Sharing is off until you set it up.
      </p>
      <p class="links">
        <a class="more" href="/search-across-machines/">Search across your machines ›</a>
        <a class="more" href="/shared-index/">Set up a shared index ›</a>
      </p>
    </div>
  </div>
</section>

<style>
  /* Which machines the search asked, and how far each has got. */
  .machines .asked {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  .machine {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    height: 1.625rem;
    padding: 0 0.625rem;
    border-radius: var(--radius-pill);
    background: var(--pill-ok-bg);
    color: var(--pill-ok-text);
    font-size: 0.75rem;
  }
  .machine b {
    font-weight: 600;
  }
  .machine.waiting {
    background: var(--pill-warn-bg);
    color: var(--pill-warn-text);
  }
  .machine :global(.os-mark) {
    width: 0.75rem;
    height: 0.75rem;
  }
  .machines .result .pill {
    margin-inline-start: 0.5rem;
    vertical-align: 0.0625rem;
  }
</style>
