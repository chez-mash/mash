---
// The header's links, each a word with its icon: the guides, the demo and the
// source. The demo is a separate app, so its link loads it afresh.
import { Icon } from "@astrojs/starlight/components";

const { locale } = Astro.locals.starlightRoute;
const guides = locale ? `/${locale}/guides/` : "/guides/";
---

<a class="mash-nav" href={guides}><Icon name="open-book" />{Astro.locals.t("mash.nav.docs")}</a>
<a class="mash-nav" href="/demo/" data-astro-reload><Icon name="laptop" />{Astro.locals.t("mash.nav.demo")}</a>
<a class="mash-nav" href="https://github.com/mashhq/mash" rel="me"><Icon name="github" />GitHub</a>

<style>
  .mash-nav {
    display: inline-flex;
    align-items: center;
    gap: 0.4375rem;
    min-height: 2.75rem;
    color: var(--text-secondary);
    font-size: var(--sl-text-sm);
    text-decoration: none;
    white-space: nowrap;
  }
  .mash-nav:hover {
    color: var(--text-strong);
  }
</style>
