---
// One of the site's interface icons (see src/icons.ts), drawn in the current
// text colour. Its weight follows its size unless one is given: bold when it
// is small enough to sit in a line of text, regular otherwise.
import { type IconName, type IconWeight, icons, weightFor } from "../icons.ts";

export type LineIconName = IconName;

interface Props {
  name: LineIconName;
  size?: string;
  weight?: IconWeight;
  class?: string;
}
const { name, size = "1em", weight = weightFor(size), class: className } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 256 256"
  width={size}
  height={size}
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
  class={className}
  set:html={icons[name][weight]}
/>
