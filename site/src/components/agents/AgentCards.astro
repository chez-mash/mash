---
// The agents whose saved chats Mash reads, one card each: what is read, how
// the agent connects (or that its history is read only), and where it has
// been tried. Every line follows the supported agents guide.
import type { Agent } from "../../../../dashboard/src/lib/types";
import AgentTile from "../AgentTile.astro";
import RailCard from "../RailCard.astro";

const connect = "/agents/#connect-claude-code-codex-or-copilot";
const connected = "Reads its chats, and connects so it can search them all.";
const read = "Reads its chats. Search them from the dashboard or a connected agent.";
const agents: {
  agent: Agent;
  name: string;
  says: string;
  href: string;
  facts: [string, string][];
}[] = [
  {
    agent: "claude-code",
    name: "Claude Code",
    says: connected,
    href: connect,
    facts: [
      ["reads", "Local conversations"],
      ["connects", "mash init, with the plugin"],
      ["tried", "Daily on Linux and macOS"],
    ],
  },
  {
    agent: "codex",
    name: "Codex",
    says: connected,
    href: connect,
    facts: [
      ["reads", "Local conversations"],
      ["connects", "mash init, through the Codex CLI"],
      ["tried", "Daily on Linux and macOS"],
    ],
  },
  {
    agent: "copilot",
    name: "GitHub Copilot",
    says: connected,
    href: "/plugin/#github-copilot-cli",
    facts: [
      ["reads", "CLI sessions and VS Code chats"],
      ["connects", "mash init, through the Copilot CLI"],
      ["tried", "Lightly on Linux and macOS"],
    ],
  },
  {
    agent: "cursor",
    name: "Cursor",
    says: read,
    href: "/supported-agents/",
    facts: [
      ["reads", "CLI chats, and supported editor chats"],
      ["connects", "History only"],
      ["tried", "With a real Cursor CLI on macOS"],
    ],
  },
  {
    agent: "opencode",
    name: "OpenCode",
    says: read,
    href: "/supported-agents/",
    facts: [
      ["reads", "The local OpenCode database"],
      ["connects", "History only"],
      ["tried", "Lightly on macOS"],
    ],
  },
  {
    agent: "antigravity",
    name: "Antigravity",
    says: read,
    href: "/supported-agents/",
    facts: [
      ["reads", "Local app and IDE databases"],
      ["connects", "History only"],
      ["tried", "Lightly on macOS"],
    ],
  },
];
---

{
  agents.map(({ agent, name, says, href, facts }) => (
    <RailCard name={name} says={says} href={href} tint={`var(--agent-${agent})`}>
      <AgentTile agent={agent} slot="mark" />
      <span class="sheet">
        <span class="big"><AgentTile agent={agent} /></span>
        {facts.map(([label, value]) => (
          <span class="fact"><i>{label}</i><b>{value}</b></span>
        ))}
      </span>
    </RailCard>
  ))
}

<style>
  .sheet {
    display: grid;
    gap: 0.5rem;
  }
  .big {
    display: grid;
    place-items: center;
    padding-bottom: 0.625rem;
  }
  .big :global(.agent-tile) {
    width: 4rem;
    height: 4rem;
    border-radius: var(--radius-7);
  }
  .fact {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 0.5rem;
    padding: 0.4375rem 0.625rem;
    border-radius: var(--radius-4);
    background: var(--surface-raised);
    box-shadow: var(--shadow-ring);
  }
  .fact i {
    color: var(--text-faint);
    font: 400 0.75rem / 1.6 var(--type-mono);
  }
  .fact b {
    color: var(--text-strong);
    font-weight: 500;
  }
</style>
