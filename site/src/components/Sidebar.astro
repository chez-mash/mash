---
// Starlight's sidebar with the phone menu's links and language picker first.
// On a phone the sidebar is the whole menu, and Starlight puts these controls
// after every guide, where a visitor would have to scroll past thirty entries
// to reach them. From 50rem wide the header holds them and this block hides.
//
// Each top-level section also gets a quiet line icon before its label, as
// the dashboard's rail does. Starlight's sidebar config has no icon field, so the
// icons are matched to the sections by position. The English labels below pin
// that order: an English page fails the build if the sections change without
// this list changing with them.
import MobileMenuFooter from "@astrojs/starlight/components/MobileMenuFooter.astro";
import SidebarPersister from "@astrojs/starlight/components/SidebarPersister.astro";
import SidebarSublist from "@astrojs/starlight/components/SidebarSublist.astro";

const { sidebar, lang } = Astro.locals.starlightRoute;

/** Lucide icon shapes (24×24, stroked), one per top-level section, in order. */
const sections = [
  {
    label: "Start here",
    shapes:
      '<path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09"/><path d="M9 12a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.4 22.4 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 .05 5 .05"/>',
  },
  {
    label: "Dashboard",
    shapes:
      '<rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/>',
  },
  {
    label: "Search",
    shapes: '<path d="m21 21-4.34-4.34"/><circle cx="11" cy="11" r="8"/>',
  },
  {
    label: "Agents and memory",
    shapes:
      '<path d="M12 8V4H8"/><rect width="16" height="12" x="4" y="8" rx="2"/><path d="M2 14h2"/><path d="M20 14h2"/><path d="M15 13v2"/><path d="M9 13v2"/>',
  },
  {
    label: "Maintenance",
    shapes:
      '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.106-3.105c.32-.322.863-.22.983.218a6 6 0 0 1-8.259 7.057l-7.91 7.91a1 1 0 0 1-2.999-3l7.91-7.91a6 6 0 0 1 7.057-8.259c.438.12.54.662.219.984z"/>',
  },
  {
    label: "Reference",
    shapes:
      '<path d="M12 5v16"/><path d="M20.001 19A2 2 0 0022 17V5a2 2 0 00-1.999-2L16 3.002A5 5 0 0012 5a5 5 0 00-4-2H4a2 2 0 00-2 2v12a2 2 0 001.999 2H8a5 5 0 014 2 5 5 0 014-2z"/>',
  },
];

// Top-level groups in sidebar order, each with its position among all the
// sidebar's top-level entries (plain links such as Troubleshooting sit between).
const groups = sidebar.flatMap((entry, index) =>
  entry.type === "group" ? [{ label: entry.label, position: index + 1 }] : [],
);
if (lang === "en") {
  const found = groups.map((group) => group.label);
  const expected = sections.map((section) => section.label);
  if (JSON.stringify(found) !== JSON.stringify(expected))
    throw new Error(
      `The sidebar's top-level sections are ${JSON.stringify(found)}, but Sidebar.astro gives icons to ${JSON.stringify(expected)}. Update its list.`,
    );
}

// The icon is a mask over the label's colour, so it follows the theme;
// currentColor only makes the mask's strokes opaque.
const mask = (shapes: string) =>
  `url("data:image/svg+xml,${encodeURIComponent(
    `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${shapes}</svg>`,
  )}")`;
const rules = sections
  .flatMap((section, index) => {
    const group = groups[index];
    return group
      ? [
          `.mash-sidebar .top-level > li:nth-child(${group.position}) > details > summary .group-label { --mash-icon: ${mask(section.shapes)}; }`,
        ]
      : [];
  })
  .join("\n");
---

<div class="mash-menu-top md:sl-hidden"><MobileMenuFooter /></div>

<div class="mash-sidebar"><SidebarPersister><SidebarSublist sublist={sidebar} /></SidebarPersister></div>

<style is:inline set:html={rules} />

<style>
  /* The controls lead the menu, so their rule sits under them. */
  .mash-menu-top :global(.mobile-preferences) {
    padding-block: 0 0.5rem;
    border-top: 0;
    border-bottom: var(--border-divider);
  }
  /* The links wrap onto a second line where their words are long, as in
     Spanish and French on a phone, rather than running off the menu. */
  .mash-menu-top :global(.social-icons) {
    flex-wrap: wrap;
    column-gap: 1.25rem;
    row-gap: 0;
    min-width: 0;
  }
  /* A section's icon sits before its label, drawn in the label's quiet
     colour through a mask. */
  .mash-sidebar :global(.top-level > li > details > summary .group-label) {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 1.25rem;
    padding-inline-start: 1.5rem;
  }
  .mash-sidebar :global(.top-level > li > details > summary .group-label)::after {
    content: "";
    position: absolute;
    inset-inline-start: 0;
    top: 50%;
    width: 0.9375rem;
    height: 0.9375rem;
    translate: 0 -50%;
    background: var(--text-faint);
    mask: var(--mash-icon, none) center / contain no-repeat;
  }
</style>
