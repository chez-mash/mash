---
// Reading a chat in the dashboard: a transcript with a picture attached to a
// message, a run of tool calls folded into one line, the subagent the chat
// started, and the export menu open. Drawn as the dashboard draws a chat,
// from made-up history; one image to assistive technology.
import AgentTile from "./AgentTile.astro";
import LineIcon from "./LineIcon.astro";
import OsMark from "./OsMark.astro";
---

<section class="band tint" id="welcome-reading" aria-labelledby="welcome-reading-title">
  <div class="wrapper split reverse" data-reveal>
    <div class="words">
      <span class="kicker">Reading</span>
      <h2 id="welcome-reading-title">Read it back. <span class="quiet">Every step of it.</span></h2>
      <p class="blurb">
        Open any chat as a transcript, with runs of tool calls and reasoning folded into one line
        until you want them. Subagents stay with the chat that started them, and attached pictures
        and files stay with their message. Save any chat as Markdown, HTML or PDF.
      </p>
      <a class="more" href="/dashboard/#find-and-read-a-chat">Read a chat in the dashboard ›</a>
    </div>
    <div class="window reading" role="img"
      aria-label="A Claude Code chat about a checkout outage, open in the dashboard: a message with a screenshot attached, four tool calls folded into one line, a subagent the chat started, and the export menu offering Markdown, HTML and PDF.">
      <div class="window-h" aria-hidden="true"><u></u><u></u><u></u><span>mash · chat</span></div>
      <div class="window-b" aria-hidden="true">
        <p class="who"><AgentTile agent="claude-code" /><b>Checkout outage review</b><span><OsMark system="windows" />build-box · 2d</span></p>
        <div class="bar">
          <span class="chip"><LineIcon name="robot" size="0.75rem" />2 subagents</span>
          <span class="chip on"><LineIcon name="download" size="0.75rem" />Export</span>
        </div>
        <p class="menu"><span>Markdown</span><span>HTML</span><span>Export to PDF</span></p>
        <div class="mine">
          <p class="bubble">Checkout is timing out for some customers. This is what they see.</p>
          <span class="attached"><i></i><b>checkout-error.png</b></span>
        </div>
        <p class="folded"><LineIcon name="wrench" size="0.875rem" />4 tool calls: Read, Grep, Bash<span>›</span></p>
        <p class="said">The migration holds a lock on orders, so every checkout request waits behind it.</p>
        <p class="folded sub"><LineIcon name="robot" size="0.875rem" />Started a subagent: find which requests failed<span>›</span></p>
      </div>
    </div>
  </div>
</section>

<style>
  .reading .bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    height: 1.625rem;
    padding: 0 0.625rem;
    border-radius: var(--radius-pill);
    background: var(--surface-muted);
    box-shadow: var(--shadow-ring-inset);
    color: var(--text-strong);
    font-size: 0.75rem;
    font-weight: 500;
  }
  .chip.on {
    margin-inline-start: auto;
    background: var(--butter);
    box-shadow: var(--shadow-tab-on);
    color: var(--text-on-butter);
  }
  /* The export menu, open under its button. */
  .reading .menu {
    display: flex;
    align-self: flex-end;
    gap: 0.125rem;
    margin-top: -0.25rem;
    padding: 0.25rem;
    border-radius: var(--radius-5);
    background: var(--surface-raised);
    box-shadow: var(--shadow-float);
    color: var(--text-strong);
    font-size: 0.8125rem;
  }
  .menu span {
    padding: 0.375rem 0.625rem;
    border-radius: var(--radius-3);
  }
  .menu span:first-child {
    background: var(--surface-hover);
  }
  .mine {
    display: grid;
    justify-items: end;
    gap: 0.4375rem;
    padding-top: 0.25rem;
  }
  .reading .mine .bubble {
    max-width: 70%;
  }
  /* A picture attached to the message: a thumbnail and its name. */
  .attached {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3125rem 0.625rem 0.3125rem 0.3125rem;
    border-radius: var(--radius-4);
    background: var(--surface-muted);
    box-shadow: var(--shadow-ring-inset);
    color: var(--text-secondary);
    font-size: 0.75rem;
  }
  .attached i {
    width: 2.75rem;
    height: 1.875rem;
    border-radius: var(--radius-2);
    background: linear-gradient(135deg, var(--desk-peach), var(--desk-butter));
    box-shadow: var(--shadow-ring-inset);
  }
  .attached b {
    font-weight: 500;
  }
  .folded {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-muted);
    font-size: 0.8125rem;
  }
  .folded span {
    margin-inline-start: auto;
    color: var(--text-faint);
  }
  .reading .folded.sub {
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-5);
    background: var(--surface-muted);
    color: var(--text-strong);
  }
  .said {
    line-height: 1.55;
  }
</style>
