---
// The agents Mash reads, each logo on a tile in its own colour beside its
// name. The names, logos and colours are the dashboard's own
// (dashboard/src/lib/agents.ts), so the site and the product always agree.
import { agents } from "../../../dashboard/src/lib/agents.ts";

const shown = ["claude-code", "codex", "copilot", "cursor", "opencode", "antigravity"] as const;
---

<div class="mash-agents not-content">
  <p class="lead">Reads the history these agents already keep</p>
  <ul aria-label="Supported agents" data-reveal>
    {shown.map((key) => {
      const agent = agents[key];
      return (
        <li>
          <span class="tile" aria-hidden="true" style={`background: ${agent.tint}; color: ${agent.ink}`} set:html={agent.logo.replace("<svg", '<svg class="mark"')} />
          <span class="name">{agent.name}</span>
        </li>
      );
    })}
  </ul>
</div>

<style>
  .mash-agents {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.375rem;
    max-width: 75rem;
    margin-inline: auto;
    padding: 4.5rem var(--mash-gutter);
  }
  .lead {
    margin: 0;
    color: var(--text-faint);
    font-size: 0.8125rem;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.875rem 2.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin: 0;
    color: var(--text-secondary);
    font-size: 1rem;
    font-weight: 500;
  }
  .tile {
    display: grid;
    place-items: center;
    width: 1.625rem;
    height: 1.625rem;
    border-radius: var(--radius-4);
    box-shadow: var(--shadow-tile);
  }
  .tile :global(.mark) {
    display: block;
    width: 0.9375rem;
    height: 0.9375rem;
  }
  /* On a phone the six agents make three rows of two. */
  @media (width < 40rem) {
    .mash-agents {
      padding-block: 3.5rem;
    }
    ul {
      display: grid;
      grid-template-columns: repeat(2, max-content);
      gap: 1rem 2.25rem;
    }
  }
</style>
