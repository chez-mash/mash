---
// The agents Mash reads, as their marks over their names. The names, files and
// colours are the dashboard's own, so the site and the product always agree.
import { agents } from "../../../dashboard/src/lib/agents.ts";

const shown = ["claude-code", "codex", "copilot", "cursor", "opencode", "antigravity"] as const;
---

<div class="mash-agents not-content">
  <ul aria-label="Supported agents" data-reveal>
    {shown.map((key) => {
      const agent = agents[key];
      const mask = `url(${agent.logo})`;
      return (
        <li>
          <span class="mark" aria-hidden="true" style={{ backgroundColor: agent.tint, maskImage: mask, WebkitMaskImage: mask }} />
          <span class="name">{agent.name}</span>
        </li>
      );
    })}
  </ul>
</div>

<style>
  .mash-agents {
    margin-block: 1rem clamp(3rem, 8vw, 6rem);
    padding-inline: 1.25rem;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem 2.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Each mark stands over its agent's name. */
  li {
    display: grid;
    justify-items: center;
    gap: 0.5rem;
  }
  .name {
    color: var(--sl-color-gray-4);
    font-size: var(--sl-text-xs);
  }
  .mash-agents .mark {
    display: block;
    width: 1.75rem;
    height: 1.75rem;
    mask: center / contain no-repeat;
    -webkit-mask: center / contain no-repeat;
  }
  /* The marks are tinted for a dark ground; flip their lightness, keep the hue. */
  :global([data-theme="light"]) .mark {
    filter: invert(1) hue-rotate(180deg);
  }
</style>
