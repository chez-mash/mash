---
// The agents Mash reads, each mark in colour on a light tile beside its name, in
// a cream band. The names and logo files are the dashboard's own, so the site
// and the product always agree. Each logo is inlined at build time and drawn in
// its brand colour through currentColor: a CSS mask through an inline style
// left the tiles empty on some iPhones, and an <img> cannot take a colour.
import { agents } from "../../../dashboard/src/lib/agents.ts";

const files = import.meta.glob<string>("../../../dashboard/public/agents/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
});

/** The logo's SVG markup, filled with the current colour. */
function logo(path: string): string {
  const name = path.split("/").pop();
  const svg = Object.entries(files).find(([file]) => file.endsWith(`/${name}`))?.[1];
  if (svg === undefined) throw new Error(`No agent logo named ${name}`);
  return svg
    .replace(/<title>.*?<\/title>/s, "")
    .replace(/\s(width|height|style|fill|role)="[^"]*"/g, "")
    .replace("<svg", '<svg class="mark" fill="currentColor" aria-hidden="true"');
}

const shown = ["claude-code", "codex", "copilot", "cursor", "opencode", "antigravity"] as const;
---

<div class="mash-agents not-content">
  <ul aria-label="Supported agents" data-reveal>
    {shown.map((key) => {
      const agent = agents[key];
      return (
        <li>
          <span class="tile" aria-hidden="true" style={`color: ${agent.tint}`} set:html={logo(agent.logo)} />
          <span class="name">{agent.name}</span>
        </li>
      );
    })}
  </ul>
  <a href="/supported-agents/">Check support for your agent</a>
</div>

<style>
  .mash-agents {
    display: grid;
    justify-items: center;
    gap: 0.875rem;
    padding: 2.125rem var(--mash-gutter);
    border-bottom: var(--border-outline);
    background: var(--surface-side);
  }
  a {
    color: var(--link);
    font-size: 0.8125rem;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--link-underline);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.875rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin: 0;
    color: var(--text-ink);
    font-weight: 700;
  }
  /* Each mark sits on an ivory sticker in its brand colour, in both themes. */
  .tile {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: var(--border-outline);
    border-radius: var(--radius-large);
    background: var(--fill-sticker);
  }
  .tile :global(.mark) {
    display: block;
    width: 1.5rem;
    height: 1.5rem;
  }
  /* On a phone the six tiles make one row and the names are read, not shown. */
  @media (width < 40rem) {
    .mash-agents {
      padding-block: 1.25rem;
    }
    ul {
      flex-wrap: nowrap;
      gap: 0.625rem;
    }
    .tile {
      width: 1.75rem;
      height: 1.75rem;
      border-radius: var(--radius-1);
    }
    .tile :global(.mark) {
      width: 1rem;
      height: 1rem;
    }
    .name {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
</style>
