---
// Where Mash runs and the ways to get it: the desktop app, the command, and
// the Raycast extension, one card each with what it is and where to get it.
import LineIcon from "./LineIcon.astro";
import OsMark from "./OsMark.astro";
---

<section class="band tint" id="welcome-platforms" aria-labelledby="welcome-platforms-title">
  <div class="wrapper stack" data-reveal>
    <div class="head">
      <span class="kicker">Install</span>
      <h2 id="welcome-platforms-title">macOS. Linux. Windows. <span class="quiet">The app, the command, or both.</span></h2>
    </div>
    <ul class="ways">
      <li>
        <span class="os-chips"><span class="ico" title="macOS"><OsMark system="macos" /></span><span class="ico" title="Linux"><OsMark system="linux" /></span><span class="ico" title="Windows"><OsMark system="windows" /></span></span>
        <h3>The desktop app</h3>
        <p>The dashboard in a window of its own, with an icon in the menu bar or tray and a shortcut for search. It keeps itself up to date.</p>
        <p class="shown"><kbd>⌥</kbd><kbd>⇧</kbd><kbd>Space</kbd><span>search from anywhere</span></p>
        <a class="more" href="/downloads/#desktop-app">Download the app ›</a>
      </li>
      <li>
        <span class="ico"><LineIcon name="terminal" /></span>
        <h3>The command</h3>
        <p>One <code>mash</code> program for search, the dashboard and the server your agents talk to. Setup finds your agents’ histories and asks before it connects anything.</p>
        <p class="shown mono"><i>$</i>mash init</p>
        <a class="more" href="/installation/">Install from the terminal ›</a>
      </li>
      <li>
        <span class="ico"><LineIcon name="command" /></span>
        <h3>The Raycast extension</h3>
        <p>Search your chats from Raycast and open one in Mash, or in the agent that wrote it.</p>
        <p class="shown"><LineIcon name="search" size="0.875rem" /><span>Search Mash</span></p>
        <a class="more" href="https://github.com/mashhq/mash/tree/main/raycast">Get the extension ›</a>
      </li>
    </ul>
  </div>
</section>

<style>
  .ways {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .ways li {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.375rem;
    border-radius: var(--radius-8);
    background: var(--surface-raised);
    box-shadow: var(--shadow-card);
  }
  .ways .ico {
    width: 2.375rem;
    height: 2.375rem;
  }
  /* The systems: each mark in an icon tile of its own, in a row. */
  .os-chips {
    display: flex;
    gap: 0.5rem;
  }
  .ways li > p:not(.shown) {
    flex: 1;
    color: var(--text-muted);
    font-size: 0.9375rem;
    line-height: 1.6;
  }
  .ways code {
    font-family: var(--type-mono);
    font-size: 0.875em;
  }
  /* A glimpse of the thing: the shortcut, the command, the Raycast command. */
  .ways .shown {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.5rem;
    padding: 0 0.75rem;
    border-radius: var(--radius-5);
    background: var(--surface-muted);
    box-shadow: var(--shadow-ring-inset);
    color: var(--text-strong);
    font-size: 0.8125rem;
  }
  .shown.mono {
    gap: 0.625rem;
    font-family: var(--type-mono);
  }
  .shown i {
    color: var(--butter-icon);
    font-style: normal;
  }
  .shown span {
    margin-inline-start: 0.25rem;
    color: var(--text-muted);
  }
  .shown kbd {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.375rem;
    height: 1.375rem;
    padding: 0 0.3125rem;
    box-sizing: border-box;
    border-radius: var(--radius-2);
    background: var(--surface-raised);
    box-shadow: var(--shadow-kbd);
    color: var(--text-secondary);
    font: 500 0.6875rem / 1 var(--type-mono);
  }
  @media (width < 56rem) {
    .ways {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
