---
// The seven scene illustrations were exported from Figma. The captions and
// links are live content, and the benchmark notes document the measurements.
import "../styles/welcome.css";
import closeArt from "../drawings/close.svg?raw";
import ferrisArt from "../drawings/ferris.svg?raw";
import mashyArt from "../drawings/mashy.svg?raw";
import memoryArt from "../drawings/memory.svg?raw";
import privacyArt from "../drawings/privacy.svg?raw";
import searchArt from "../drawings/search.svg?raw";
import speedArt from "../drawings/speed.svg?raw";
import Agents from "./Agents.astro";
---

<div class="mash-welcome not-content">
  <Agents />

  <section class="scene" id="welcome-search" aria-labelledby="welcome-search-title">
    <div class="stage">
      <Fragment set:html={searchArt} />
      <div class="head">
        <span class="eyebrow">Search</span>
        <h2 id="welcome-search-title">Find it. <span>However you remember it.</span></h2>
      </div>
      <div class="show">
        <img class="scene-image" src="/welcome/welcome-search.svg" width="672" height="393" decoding="async"
          alt="The example search ‘why does checkout keep failing’ finds three chats about a checkout outage, from Claude Code, Codex, and Cursor on separate machines." />
        <ol class="caps">
          <li>By meaning, with optional local models.</li>
          <li>By the exact words.</li>
          <li>Across machines through a server you run.</li>
        </ol>
        <p class="links">
          <a href="/demo/#/chat/checkout-outage-review?node=build-box&amp;message=checkout-outage-review-1&amp;shared=true" data-astro-reload>Read the checkout chat in the demo ›</a>
        </p>
      </div>
    </div>
  </section>

  <section class="scene" id="welcome-mashy" aria-labelledby="welcome-mashy-title">
    <div class="stage">
      <Fragment set:html={mashyArt} />
      <div class="head">
        <span class="eyebrow">Dashboard</span>
        <h2 id="welcome-mashy-title">Meet Mashy. <span>Ask your history anything.</span></h2>
      </div>
      <div class="show">
        <img class="scene-image" src="/welcome/welcome-mashy.svg" width="410" height="511" decoding="async"
          alt="The read-only assistant traces an example checkout outage to a database migration and quotes the Claude Code conversation that describes the lock." />
        <ol class="caps">
          <li>Ask in plain language.</li>
          <li>Mashy reads across agents and machines.</li>
          <li>Follow the quote back to the original chat.</li>
          <li>Optional. Requires your own model service and API key.</li>
        </ol>
      </div>
    </div>
  </section>

  <section class="scene" id="welcome-memory" aria-labelledby="welcome-memory-title">
    <div class="stage">
      <Fragment set:html={memoryArt} />
      <div class="head">
        <span class="eyebrow">Memory</span>
        <h2 id="welcome-memory-title">Save the decision. <span>Keep the source.</span></h2>
      </div>
      <div class="show">
        <img class="scene-image" src="/welcome/welcome-memory.svg" width="672" height="452" decoding="async"
          alt="A saved decision to use 15-minute access tokens cites the original Claude Code message and appears in a later Codex session." />
        <ol class="caps">
          <li>You say it.</li>
          <li>Ask the plugin to save the decision with your message as evidence.</li>
          <li>The decision can come back in a later session.</li>
        </ol>
        <p class="links">
          <a href="/demo/#/record/record-sign-in-tokens?node=laptop" data-astro-reload>Follow the sign-in decision in the demo ›</a>
        </p>
      </div>
    </div>
  </section>

  <section class="scene speed" id="welcome-speed" aria-labelledby="welcome-speed-title">
    <div class="stage">
      <Fragment set:html={speedArt} />
      <div class="head">
        <span class="eyebrow">Performance</span>
        <h2 id="welcome-speed-title">Fast, and light on your machine.</h2>
      </div>
      <div class="show">
        <img class="scene-image" src="/welcome/welcome-performance.svg" width="760" height="379" decoding="async"
          alt="Example measurements range from a 66 ms word search and about 20 MB for idle MCP to 5× embedding throughput on a Windows GPU and 9× with an experimental NVIDIA worker. Word search needs no GPU." />
        <details class="measured">
          <summary>How these were measured</summary>
          <div class="measurement-copy" role="region" aria-label="Benchmark conditions" tabindex="0">
            <dl>
              <div>
                <dt>66 ms</dt>
                <dd>One exact-phrase search across 1,137 chats and about 103,000 searchable messages on one Linux machine. A common word took up to a second there.</dd>
              </div>
              <div>
                <dt>20 MB</dt>
                <dd>Approximate memory for one idle Mash MCP process. On that machine, idle processes used 16–23 MB each, or 220–330 MB after loading semantic search models. Qdrant memory was measured separately.</dd>
              </div>
              <div>
                <dt>5× and 9×</dt>
                <dd>Embedding throughput while indexing, on a Tesla T4 against four CPU cores. DirectML on Windows processed about 90 messages a second versus 17 on CPU. The experimental NVIDIA worker processed about 155 versus 18 on CPU.</dd>
              </div>
            </dl>
            <p>
              The NVIDIA worker and GPU reranking are experimental and off until you
              <a href="/configuration/">turn them on</a>.
            </p>
          </div>
        </details>
      </div>
    </div>
  </section>

  <section class="scene" id="welcome-privacy" aria-labelledby="welcome-privacy-title">
    <div class="stage">
      <Fragment set:html={privacyArt} />
      <div class="head">
        <span class="eyebrow">Privacy</span>
        <h2 id="welcome-privacy-title">Self-hosted, end to end. <span>No cloud. No account.</span></h2>
      </div>
      <div class="show">
        <img class="scene-image" src="/welcome/welcome-privacy.svg" width="760" height="241" decoding="async"
          alt="History stays on this machine by default. If you choose to share, machines publish to a server you run. Credential masking is on by default, and sharing, remote workers, and Mashy are opt-in." />
        <ol class="caps">
          <li>Index and search on the machine where your chats were saved.</li>
          <li>When you opt in to sharing, you choose which machines publish.</li>
        </ol>
        <p class="links"><a href="/privacy/">How Mash handles your history ›</a></p>
      </div>
    </div>
  </section>

  <section class="scene more" aria-label="More about Mash">
    <div class="stage">
      <div class="show">
        <img class="scene-image" src="/welcome/welcome-features.svg" width="760" height="312" decoding="async"
          alt="The agent plugin brings earlier context into new sessions. Hybrid search combines words and meaning, sharing uses your own server, and chats export to Markdown, HTML, or PDF. Mash runs on macOS, Linux, and Windows." />
        <p class="links">
          <a href="/plugin/">Plugin for Claude Code, Codex and Copilot ›</a>
          <a href="/search/">Hybrid search ›</a>
          <a href="/shared-index/">Shared index ›</a>
        </p>
      </div>
    </div>
  </section>

  <section class="scene" id="welcome-rust" aria-labelledby="welcome-rust-title">
    <div class="stage">
      <Fragment set:html={ferrisArt} />
      <div class="head">
        <span class="eyebrow">Open source</span>
        <h2 id="welcome-rust-title">Written with <b class="turn">&lt;3</b> in Rust.</h2>
      </div>
      <div class="show">
        <img class="scene-image" src="/welcome/welcome-rust.svg" width="760" height="225" decoding="async"
          alt="Ferris the crab beside the Mash repository name and its MIT and Apache 2.0 licenses." />
        <p class="blurb">
          Mash is free and open source under the MIT and Apache 2.0 licenses. Ideas, issues and pull
          requests are welcome.
        </p>
        <p class="links">
          <a href="https://github.com/mashium/mash">Read the source ›</a>
          <a href="https://github.com/mashium/mash/blob/main/CONTRIBUTING.md">Contribute ›</a>
        </p>
      </div>
    </div>
  </section>

  <section class="close backdrop" aria-labelledby="welcome-close">
    <Fragment set:html={closeArt} />
    <div class="closing" data-reveal>
      <h2 id="welcome-close">Give your agents <span class="turn">a memory.</span></h2>
      <p class="actions">
        <a class="button" href="/quick-start/">Get started</a>
        <a href="/guides/">Read the docs ›</a>
      </p>
    </div>
  </section>
</div>

<script>
  import { mountWelcome } from "../welcome.ts";

  let unmount: (() => void) | undefined;
  // Runs on the first load and after each page change; leaving the page stops it.
  document.addEventListener("astro:page-load", () => {
    unmount?.();
    unmount = undefined;
    const root = document.querySelector<HTMLElement>(".mash-welcome");
    if (root) unmount = mountWelcome(root, document.querySelector<HTMLElement>(".mash-hero"));
  });
</script>
