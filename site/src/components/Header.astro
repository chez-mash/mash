---
// The site header, as the wireframes draw it: the blue tile and the lowercase
// name whose full stop is a pat of butter, "Docs" beside it on the docs pages,
// search in the middle, then the guides and the source, the theme and
// language menus, and the desktop app for the Mac in ink.
//
// On the landing page the header is an island: a rounded bar on a translucent
// surface that stays at the top while the page scrolls under it. Search is
// hidden there, but kept mounted so its shortcut and query survive moving
// between pages. On a phone the island is the logo alone until the hero's
// buttons have scrolled away, when a small download button fades in beside
// it: the hero and the footer lead to the guides. The other
// page without a sidebar, the missing page, gets a menu holding the links and
// both menus; docs pages, the guides directory among them, keep Starlight's
// menu button, which opens the sidebar with the same controls at its top. The
// two buttons are one raised square at the left with the same three lines,
// and the landing page keeps the theme and language menus in its footer.
import { Icon } from "@astrojs/starlight/components";
import ThemeSelect from "@astrojs/starlight/components/ThemeSelect.astro";
import LanguageSelect from "./LanguageSelect.astro";
import LineIcon from "./LineIcon.astro";
import OsMark from "./OsMark.astro";
import Search from "./Search.astro";
import SocialIcons from "./SocialIcons.astro";

const { hasSidebar, entry, locale } = Astro.locals.starlightRoute;
const home = entry.data.template === "splash" && entry.data.hero !== undefined;
const base = locale ? `/${locale}/` : "/";
const t = Astro.locals.t;
---

<!-- The copy buttons on code blocks show this word beside their icon. -->
<style is:inline set:html={`:root{--mash-copy-label:${JSON.stringify(t("mash.copy"))}}`}></style>
<div class:list={["mash-header", { home }]}>
  {
    !hasSidebar && !home && (
      <details class="mash-menu">
        <summary aria-label={t("mash.menu")}>
          <Icon name="bars" />
        </summary>
        <div class="panel">
          <nav class="links"><SocialIcons /></nav>
          <div class="controls">
            <ThemeSelect />
            <LanguageSelect />
          </div>
        </div>
      </details>
    )
  }
  <a class="brand" href={base}>
    <img src="/mash-mark.svg" alt="" width="22" height="22" />
    <span class="name">mash<i class="pat" aria-hidden="true"></i></span>
    {!home && <span class="section">{t("mash.nav.docs")}</span>}
  </a>
  <div class="search"><Search /></div>
  <nav class="links wide" aria-label={t("mash.nav.label")}>
    <a href={`${base}guides/`}>{t("mash.nav.docs")}</a>
    <a href="https://github.com/mashhq/mash" rel="me">GitHub</a>
  </nav>
  <div class="prefs wide">
    <ThemeSelect />
    <LanguageSelect />
  </div>
  {
    home ? (
      // The same download as the hero's button, which Hero.astro's script points at the visitor's system.
      <a class="download" href="/downloads/#desktop-app" data-download data-system="macos">
        <OsMark system="macos" /><OsMark system="windows" /><OsMark system="linux" />
        <span class="long" data-download-label>{t("mash.download.mac")}</span>
        <span class="short"><LineIcon name="download" size="0.875rem" />{t("mash.download.short")}</span>
      </a>
    ) : (
      <a class="download" href="/downloads/#desktop-app">
        <OsMark system="macos" />
        <span>{t("mash.download.mac")}</span>
      </a>
    )
  }
</div>

<style>
  .mash-header {
    display: flex;
    align-items: center;
    gap: 0.75rem 1rem;
    height: 100%;
  }
  .brand {
    display: flex;
    flex: none;
    align-items: center;
    gap: 0.5625rem;
    color: var(--brand-name);
    text-decoration: none;
  }
  .brand img {
    width: 1.375rem;
    height: 1.375rem;
  }
  .name {
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }
  /* The wordmark's full stop is the pat of butter from the logo: a small
     rounded square, tilted as in the mark, sitting on the baseline. */
  .pat {
    display: inline-block;
    width: 0.26em;
    height: 0.24em;
    margin-inline-start: 0.07em;
    border-radius: var(--radius-1);
    background: var(--brand-pat);
    transform: rotate(-9deg);
  }
  .section {
    margin-inline-start: 0.125rem;
    color: var(--text-faint);
    font-size: 0.875rem;
  }
  .search {
    display: flex;
    flex: 1;
    justify-content: center;
    min-width: 0;
  }
  .links {
    display: flex;
    align-items: center;
    gap: 0.125rem;
  }
  .links a {
    display: flex;
    align-items: center;
    height: 2rem;
    padding: 0 0.625rem;
    border-radius: var(--radius-4);
    color: var(--text-secondary);
    font-size: 0.8125rem;
    text-decoration: none;
  }
  .links a:hover {
    background: var(--surface-hover);
    color: var(--text-strong);
  }
  .prefs {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  /* The desktop app, in ink with the Apple mark in the action's text colour. */
  .download {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 0.4375rem;
    height: 2rem;
    padding: 0 0.875rem;
    border-radius: var(--radius-4);
    background: var(--action-bg);
    box-shadow: var(--shadow-button);
    color: var(--action-text);
    font-size: 0.8125rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }
  .download:hover {
    background: var(--action-hover-bg);
  }
  .download :global(svg) {
    width: 0.8125rem;
    height: 0.8125rem;
  }

  /* On the landing page the header is an island: a rounded bar, fixed over
     the page (custom.css), on a surface the page shows through, blurred.
     The surface is mostly opaque, so the words keep their contrast whatever
     scrolls under them. */
  .home {
    padding-inline: 0.875rem 0.5rem;
    border-radius: var(--radius-8);
    background: color-mix(in srgb, var(--surface-raised) 82%, transparent);
    box-shadow: var(--shadow-float);
    backdrop-filter: blur(18px) saturate(1.4);
    pointer-events: auto;
  }
  .short,
  .download[data-system="macos"] :global(.os-mark:not([data-system="macos"])),
  .download[data-system="windows"] :global(.os-mark:not([data-system="windows"])),
  .download[data-system="linux"] :global(.os-mark:not([data-system="linux"])) {
    display: none;
  }
  /* The links follow the name, search is hidden, and the download sits at
     the far end. */
  .home .search {
    order: 2;
    visibility: hidden;
  }
  .home .links.wide {
    order: 1;
    margin-inline-start: 0.75rem;
  }
  .home .prefs,
  .home .download {
    order: 3;
  }
  /* Over the hero's light the links take the strong text colour, and the
     light is faded under the header (Hero.astro), so they stay readable
     wherever a streak drifts. */
  .home .links a {
    color: var(--text-strong);
    font-size: 0.875rem;
  }

  .mash-menu {
    display: none;
  }
  @media (width < 72rem) {
    .prefs.wide {
      display: none;
    }
  }
  @media (width < 50rem) {
    .wide,
    .download {
      display: none;
    }
    /* The menu leads, as Starlight's button does on the pages with a
       sidebar, and the logo follows at the same distance. */
    .mash-menu {
      display: block;
      margin-inline-end: -0.25rem;
    }
    /* As wide as its button, so the button ends at the gutter rather than
       hanging half out of an empty box and off the screen. */
    .search {
      flex: none;
      order: 3;
      margin-inline-start: auto;
    }
    .home .search {
      display: none;
    }
    /* A phone's island gains its one action once the hero's buttons have
       scrolled away (the script below marks the island then): a short
       download button, with a tap target larger than it looks. */
    .home .download {
      position: relative;
      display: inline-flex;
      visibility: hidden;
      height: 2.25rem;
      margin-inline-start: auto;
      opacity: 0;
      transition:
        opacity 0.2s ease-out,
        visibility 0.2s;
    }
    .home .download::after {
      position: absolute;
      inset: -0.3125rem 0;
      content: "";
    }
    .home[data-past-hero] .download {
      visibility: visible;
      opacity: 1;
    }
    .home .download .long,
    .home .download > :global(.os-mark) {
      display: none;
    }
    .home .short {
      display: inline-flex;
      align-items: center;
      gap: 0.4375rem;
    }
  }
  /* Starlight's button, measure for measure: its glyph starts at the
     padding rather than the middle, and this one sits where that one does. */
  .mash-menu summary {
    display: flex;
    box-sizing: border-box;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0.5rem;
    border-radius: var(--radius-5);
    background: var(--surface-raised);
    box-shadow: var(--shadow-ring);
    color: var(--text-strong);
    font-size: 1rem;
    list-style: none;
    cursor: pointer;
  }
  .mash-menu summary::-webkit-details-marker {
    display: none;
  }
  .panel {
    position: fixed;
    inset: var(--sl-nav-height) 0 auto;
    z-index: var(--sl-z-index-menu);
    display: grid;
    gap: 1rem;
    padding: 1rem var(--sl-nav-pad-x) 1.25rem;
    background: var(--surface-page);
    box-shadow: var(--shadow-float);
  }
  .panel .links {
    display: grid;
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }
</style>

<style is:global>
  /* A link into the landing page stops under the island, not behind it. */
  html:has(.mash-header.home) {
    scroll-padding-top: 5rem;
  }
</style>

<script>
  // The landing island's download button waits until the hero's own buttons
  // have scrolled up out of view.
  let watching: IntersectionObserver | undefined;
  document.addEventListener("astro:page-load", () => {
    watching?.disconnect();
    const island = document.querySelector<HTMLElement>(".mash-header.home");
    const actions = document.querySelector(".mash-hero .actions");
    if (!island || !actions) return;
    watching = new IntersectionObserver(([entry]) => {
      const past = entry !== undefined && !entry.isIntersecting && entry.boundingClientRect.top < 0;
      island.toggleAttribute("data-past-hero", past);
    });
    watching.observe(actions);
  });

  // Copy buttons anywhere on the site, such as the prompt for an agent: one
  // listener serves every page change. The button says so once it has copied.
  document.addEventListener("click", async (event) => {
    const button = event.target instanceof Element ? event.target.closest("button[data-copy]") : null;
    if (!(button instanceof HTMLButtonElement)) return;
    // A button with an icon keeps it and changes only its label.
    const target = button.querySelector("[data-label]") ?? button;
    const label = target.textContent;
    try {
      await navigator.clipboard.writeText(button.dataset.copy ?? "");
      target.textContent = button.dataset.copied ?? "Copied";
      setTimeout(() => {
        target.textContent = label;
      }, 2000);
    } catch {
      // Without clipboard access, select the words so they can be copied by hand.
      const words = button.parentElement?.querySelector("code, p");
      if (words) getSelection()?.selectAllChildren(words);
    }
  });
</script>
